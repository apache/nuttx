From 9f590ea6283f0aad4ac77d69f21f57f7f1dbc1e3 Mon Sep 17 00:00:00 2001
From: Bowen Wang <wangbowen6@xiaomi.com>
Date: Wed, 28 Jan 2026 21:37:53 +0800
Subject: [PATCH 18/18] lib/rpmsg: add priority support for rpmsg endpoint

Add a priority to struct rpmsg_endpoint and pass it to the transport
with every message, so a transport can order or schedule its TX traffic
by endpoint:

- define RPMSG_PRIO_MIN (0), RPMSG_PRIO_DEFAULT (127), RPMSG_PRIO_MAX
  (255) and RPMSG_PRIO_RT as an alias of the maximum
- add the priority field to struct rpmsg_endpoint, set to the default in
  rpmsg_register_endpoint() when the caller left it at 0
- add rpmsg_set_priority()
- add a priority argument to the send_offchannel_raw and
  get_tx_payload_buffer device ops; rpmsg_send_offchannel_raw() and
  rpmsg_get_tx_payload_buffer() pass ept->priority, and rpmsg_virtio
  accepts and ignores it

Signed-off-by: Bowen Wang <wangbowen6@xiaomi.com>
Signed-off-by: Yongrong Wang <wangyongrong@xiaomi.com>
---
 lib/include/openamp/rpmsg.h | 27 +++++++++++++++++++++++++--
 lib/rpmsg/rpmsg.c           | 18 ++++++++++++++++--
 lib/rpmsg/rpmsg_virtio.c    | 12 ++++++++----
 3 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/lib/include/openamp/rpmsg.h open-amp/lib/include/openamp/rpmsg.h
index 5b70233..e6409de 100644
--- a/lib/include/openamp/rpmsg.h
+++ open-amp/lib/include/openamp/rpmsg.h
@@ -53,6 +53,11 @@ extern "C" {
 #define RPMSG_ERR_PERM			(RPMSG_ERROR_BASE - 8)
 #define RPMSG_EOPNOTSUPP		(RPMSG_ERROR_BASE - 9)
 
+#define RPMSG_PRIO_MIN			0
+#define RPMSG_PRIO_DEFAULT		127
+#define RPMSG_PRIO_MAX			255
+#define RPMSG_PRIO_RT			RPMSG_PRIO_MAX
+
 struct rpmsg_endpoint;
 struct rpmsg_device;
 
@@ -102,6 +107,9 @@ struct rpmsg_endpoint {
 	/** Endpoint service unbind callback, called when remote ept is destroyed */
 	rpmsg_ns_unbind_cb ns_unbind_cb;
 
+	/** The priority of current rpmsg endpoint */
+	uint8_t priority;
+
 	/** Endpoint node */
 	struct metal_list node;
 
@@ -114,7 +122,8 @@ struct rpmsg_device_ops {
 	/** Send RPMsg data */
 	int (*send_offchannel_raw)(struct rpmsg_device *rdev,
 				   uint32_t src, uint32_t dst,
-				   const void *data, int len, int wait);
+				   const void *data, int len, int wait,
+				   uint8_t priority);
 
 	/** Hold RPMsg RX buffer */
 	void (*hold_rx_buffer)(struct rpmsg_device *rdev, void *rxbuf);
@@ -124,7 +133,8 @@ struct rpmsg_device_ops {
 
 	/** Get RPMsg TX buffer */
 	void *(*get_tx_payload_buffer)(struct rpmsg_device *rdev,
-				       uint32_t *len, int wait);
+				       uint32_t *len, int wait,
+				       uint8_t priority);
 
 	/** Send RPMsg data without copy */
 	int (*send_offchannel_nocopy)(struct rpmsg_device *rdev,
@@ -591,6 +601,19 @@ static inline int rpmsg_send_nocopy(struct rpmsg_endpoint *ept,
 	return RPMSG_ERR_ADDR;
 }
 
+/**
+ * @brief Set the priority of the RPMsg endpoint
+ *
+ * The priority is passed to the transport with every message the endpoint
+ * sends, so a transport can order or schedule its TX traffic by it.
+ *
+ * @param ept		RPMsg endpoint pointer
+ * @param priority	Endpoint priority, RPMSG_PRIO_MIN to RPMSG_PRIO_MAX
+ *
+ * @return 0 on success, RPMSG_ERR_PARAM if ept is NULL
+ */
+int rpmsg_set_priority(struct rpmsg_endpoint *ept, uint8_t priority);
+
 /**
  * @brief Create rpmsg endpoint and register it to rpmsg device
  *
diff --git a/lib/rpmsg/rpmsg.c open-amp/lib/rpmsg/rpmsg.c
index 28a8de6..feb69a4 100644
--- a/lib/rpmsg/rpmsg.c
+++ open-amp/lib/rpmsg/rpmsg.c
@@ -130,7 +130,8 @@ int rpmsg_send_offchannel_raw(struct rpmsg_endpoint *ept, uint32_t src,
 
 	if (rdev->ops.send_offchannel_raw)
 		return rdev->ops.send_offchannel_raw(rdev, src, dst, data,
-						     len, wait);
+						     len, wait,
+						     ept->priority);
 
 	return RPMSG_ERR_PARAM;
 }
@@ -204,7 +205,8 @@ void *rpmsg_get_tx_payload_buffer(struct rpmsg_endpoint *ept,
 	rdev = ept->rdev;
 
 	if (rdev->ops.get_tx_payload_buffer)
-		return rdev->ops.get_tx_payload_buffer(rdev, len, wait);
+		return rdev->ops.get_tx_payload_buffer(rdev, len, wait,
+						       ept->priority);
 
 	return NULL;
 }
@@ -286,6 +288,15 @@ struct rpmsg_endpoint *rpmsg_get_endpoint(struct rpmsg_device *rdev,
 	return NULL;
 }
 
+int rpmsg_set_priority(struct rpmsg_endpoint *ept, uint8_t priority)
+{
+	if (!ept)
+		return RPMSG_ERR_PARAM;
+
+	ept->priority = priority;
+	return 0;
+}
+
 static void rpmsg_unregister_endpoint(struct rpmsg_endpoint *ept)
 {
 	struct rpmsg_device *rdev = ept->rdev;
@@ -318,6 +329,9 @@ void rpmsg_register_endpoint(struct rpmsg_device *rdev,
 	ept->ns_unbind_cb = ns_unbind_cb;
 	ept->priv = priv;
 	ept->rdev = rdev;
+	if (ept->priority == RPMSG_PRIO_MIN)
+		ept->priority = RPMSG_PRIO_DEFAULT;
+
 	metal_list_add_tail(&rdev->endpoints, &ept->node);
 }
 
diff --git a/lib/rpmsg/rpmsg_virtio.c open-amp/lib/rpmsg/rpmsg_virtio.c
index 9913d87..758ab74 100644
--- a/lib/rpmsg/rpmsg_virtio.c
+++ open-amp/lib/rpmsg/rpmsg_virtio.c
@@ -354,7 +354,8 @@ static int rpmsg_virtio_notify_wait(struct rpmsg_virtio_device *rvdev, struct vi
 }
 
 static void *rpmsg_virtio_get_tx_payload_buffer(struct rpmsg_device *rdev,
-						uint32_t *len, int wait)
+						uint32_t *len, int wait,
+						uint8_t priority)
 {
 	struct rpmsg_virtio_device *rvdev;
 	struct rpmsg_hdr *rp_hdr;
@@ -362,6 +363,8 @@ static void *rpmsg_virtio_get_tx_payload_buffer(struct rpmsg_device *rdev,
 	int tick_count;
 	int status;
 
+	metal_unused(priority);
+
 	/* Get the associated remote device for channel. */
 	rvdev = metal_container_of(rdev, struct rpmsg_virtio_device, rdev);
 
@@ -500,8 +503,8 @@ static int rpmsg_virtio_release_tx_buffer(struct rpmsg_device *rdev, void *txbuf
  */
 static int rpmsg_virtio_send_offchannel_raw(struct rpmsg_device *rdev,
 					    uint32_t src, uint32_t dst,
-					    const void *data,
-					    int len, int wait)
+					    const void *data, int len,
+					    int wait, uint8_t priority)
 {
 	struct rpmsg_virtio_device *rvdev;
 	struct metal_io_region *io;
@@ -513,7 +516,8 @@ static int rpmsg_virtio_send_offchannel_raw(struct rpmsg_device *rdev,
 	rvdev = metal_container_of(rdev, struct rpmsg_virtio_device, rdev);
 
 	/* Get the payload buffer. */
-	buffer = rpmsg_virtio_get_tx_payload_buffer(rdev, &buff_len, wait);
+	buffer = rpmsg_virtio_get_tx_payload_buffer(rdev, &buff_len, wait,
+						    priority);
 	if (!buffer)
 		return RPMSG_ERR_NO_BUFF;
 
-- 
