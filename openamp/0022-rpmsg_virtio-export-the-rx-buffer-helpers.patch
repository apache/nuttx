From 2ade8c2d4e47e2e8bd7686d997e0fe663ecd5ea3 Mon Sep 17 00:00:00 2001
From: Yongrong Wang <wangyongrong@xiaomi.com>
Date: Mon, 2 Nov 2026 21:32:10 +0800
Subject: [PATCH 0022/23] rpmsg_virtio: export the rx buffer helpers

Make rpmsg_virtio_get_rx_buffer(), rpmsg_virtio_release_rx_buffer_nolock()
and rpmsg_virtio_buf_held_dec_test() public and move the buffer held
counter macros to rpmsg_internal.h, so a transport can walk the rx
virtqueue and dispatch the buffers itself.

Signed-off-by: Yongrong Wang <wangyongrong@xiaomi.com>
Signed-off-by: Bowen Wang <wangbowen6@xiaomi.com>
---
 lib/include/openamp/rpmsg.h        |   1 +
 lib/include/openamp/rpmsg_virtio.h |  33 ++++++
 lib/rpmsg/rpmsg_internal.h         |  19 ++++
 lib/rpmsg/rpmsg_virtio.c           | 158 +++++++++++------------------
 4 files changed, 112 insertions(+), 99 deletions(-)

diff --git a/lib/include/openamp/rpmsg.h open-amp/lib/include/openamp/rpmsg.h
index e6409de..5737066 100644
--- a/lib/include/openamp/rpmsg.h
+++ open-amp/lib/include/openamp/rpmsg.h
@@ -58,6 +58,7 @@ extern "C" {
 #define RPMSG_PRIO_MAX			255
 #define RPMSG_PRIO_RT			RPMSG_PRIO_MAX
 
+struct rpmsg_hdr;
 struct rpmsg_endpoint;
 struct rpmsg_device;
 
diff --git a/lib/include/openamp/rpmsg_virtio.h open-amp/lib/include/openamp/rpmsg_virtio.h
index 5eef8b7..89275db 100644
