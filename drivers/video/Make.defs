# Include video drivers

ifeq ($(CONFIG_DRIVERS_VIDEO),y)

ifeq ($(CONFIG_VIDEO_FB),y)
  CSRCS += fb.c
endif

ifeq ($(CONFIG_VIDEO_STREAM),y)
  CSRCS += v4l2_core.c video_framebuff.c v4l2_cap.c v4l2_m2m.c
endif

ifeq ($(CONFIG_VIDEO_FB_SPLASHSCREEN),y)
  ifeq ($(CONFIG_VIDEO_FB_SPLASHSCREEN_NXLOGO),y)
    ifeq ($(CONFIG_VIDEO_FB_SPLASHSCREEN_NXLOGO_320),y)
      CSRCS += nxlogo320.c
    else ifeq ($(CONFIG_VIDEO_FB_SPLASHSCREEN_NXLOGO_160),y)
      CSRCS += nxlogo160.c
    else
      CSRCS += nxlogo80.c
    endif
  endif
endif

# These video drivers depend on I2C support

ifeq ($(CONFIG_I2C),y)

ifeq ($(CONFIG_VIDEO_ISX012),y)
  CSRCS += isx012.c
endif

ifeq ($(CONFIG_VIDEO_ISX019),y)
  CSRCS += isx019.c
endif

ifeq ($(CONFIG_VIDEO_OV2640),y)
  CSRCS += ov2640.c
endif

ifeq ($(CONFIG_VIDEO_GC0308),y)
  CSRCS += gc0308.c
endif

ifeq ($(CONFIG_VIDEO_VL53L5CX),y)
  CSRCS += vl53l5cx.c

# ST firmware and default data (BSD-3-Clause) from the VL53L5CX ULD in
# X-CUBE-TOF1.  Files already present are not downloaded again.

VL53L5CX_ULD_URL = https://raw.githubusercontent.com/STMicroelectronics/x-cube-tof1/v3.4.3/Drivers/BSP/Components/vl53l5cx
VL53L5CX_DIR     = $(TOPDIR)$(DELIM)drivers$(DELIM)video$(DELIM)vl53l5cx
VL53L5CX_FILES   = $(VL53L5CX_DIR)$(DELIM)vl53l5cx_buffers.h
VL53L5CX_FILES  += $(VL53L5CX_DIR)$(DELIM)LICENSE.md

$(VL53L5CX_DIR)$(DELIM)vl53l5cx_buffers.h:
	$(call DOWNLOAD,$(VL53L5CX_ULD_URL)/modules,vl53l5cx_buffers.h,$@)

$(VL53L5CX_DIR)$(DELIM)LICENSE.md:
	$(call DOWNLOAD,$(VL53L5CX_ULD_URL),LICENSE.md,$@)

context:: $(VL53L5CX_FILES)

distclean::
	$(call DELFILE, $(VL53L5CX_FILES))
endif

endif

ifeq ($(CONFIG_GOLDFISH_FB),y)
  CSRCS += goldfish_fb.c
endif

ifeq ($(CONFIG_GOLDFISH_GPU_FB),y)
  CSRCS += goldfish_gpu_fb.c
endif

# These video drivers depend on SPI support

ifeq ($(CONFIG_SPI),y)

ifeq ($(CONFIG_VIDEO_MAX7456),y)
  CSRCS += max7456.c
endif

endif

ifeq ($(CONFIG_GOLDFISH_CAMERA),y)
  CSRCS += goldfish_camera.c
endif

include video/vnc/Make.defs
include video/mipidsi/Make.defs

# Include video driver build support

DEPPATH += --dep-path video
VPATH += :video
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)drivers$(DELIM)video

endif
