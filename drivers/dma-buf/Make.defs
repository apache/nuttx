# Include dma buf drivers

ifeq ($(CONFIG_DMA_SHARED_BUFFER),y)

CSRCS += dma-buf.c

ifeq ($(CONFIG_DMABUF_HEAPS),y)
CSRCS += dma-heap.c system_heap.c
endif

# Include dma buf driver build support

DEPPATH += --dep-path dma-buf
VPATH += :dma-buf
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)drivers$(DELIM)dma-buf

endif # CONFIG_DMA_SHARED_BUFFER
