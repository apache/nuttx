config RPMSG
	bool
	default n
	select OPENAMP
	select SCHED_WORKQUEUE

if RPMSG

config RPMSG_CHAR
	bool "rpmsg char support"
	default n
	---help---
		User can use the /dev/rpmsg/<cpuname> to create the
		endpoint and then use /dev/rpmsg-<name> to communicate with
		remote processor.

config RPMSG_CHAR_NPOLLWAITERS
	int "rpmsg char number of the poll waiters"
	default 2
	depends on RPMSG_CHAR

config RPMSG_WQUEUE_GLOBAL
	bool "rpmsg global work queue"
	default n
	---help---
		This is for rpmsg global work queue.

config RPMSG_WQUEUE_PRIORITY
	int "rpmsg work queue priority"
	default 224

config RPMSG_WQUEUE_STACKSIZE
	int "rpmsg work queue stack size"
	default 8192 if ARCH_64BIT && DEFAULT_TASK_STACKSIZE < 8192
	default DEFAULT_TASK_STACKSIZE

config RPMSG_WQUEUE_NUMBER
	int "rpmsg work queue number"
	default 1
	range 1 256
	---help---
		This macro sets the number of rpmsg work queue. It can be
		customized and the minimum value is 1.

config RPMSG_RECURSIVE_LIMIT
	int "rpmsg recursive limit"
	default 8 if ARCH_SIM
	default 2 if RPMSG_WQUEUE_STACKSIZE <= 4096
	default 3 if RPMSG_WQUEUE_STACKSIZE <= 5120
	default 4 if RPMSG_WQUEUE_STACKSIZE <= 6144
	default 5 if RPMSG_WQUEUE_STACKSIZE <= 7168
	default 6 if RPMSG_WQUEUE_STACKSIZE <= 8192
	default 7 if RPMSG_WQUEUE_STACKSIZE <= 9216
	default 8
	---help---
		This macro sets the maximum recursion depth allowed in the
		rpmsg dispatch function.

config RPMSG_TRACE
	bool "rpmsg trace"
	default n
	depends on SCHED_INSTRUMENTATION_DUMP
	---help---
		Record the messages passed through the rpmsg transports in the
		note stream under NOTE_TAG_RPMSG, so they can be read back with
		the note drivers (e.g. /dev/note/ram).

config RPMSG_TRACE_BACKTRACE
	int "rpmsg trace backtrace depth"
	default 0
	range 0 16
	depends on RPMSG_TRACE
	---help---
		Number of frames recorded with a trace that asks for a
		backtrace. 0 disables backtraces.

config RPMSG_PROCFS
	bool "Include rpmsg info in procfs"
	depends on FS_PROCFS_REGISTER
	default !DEFAULT_SMALL
	---help---
		Add /proc/rpmsg, which lists the local and the remote CPU of every
		registered rpmsg device.

config RPMSG_LOCAL_CPUNAME
	string "Rpmsg Local Cpuname"
	default LIBC_HOSTNAME

config RPMSG_PING
	bool "rpmsg ping support"
	default n
	---help---
		This is for debugging & profiling, create ping rpmsg
		channel, user can use it to get send/recv speed & latency.

config RPMSG_TEST
	bool "rpmsg test support"
	default n

config RPMSG_WAKELOCK
	bool "rpmsg wakelock support"
	default n
	depends on PM
	---help---
		Let a CPU hold a PM wakelock on the remote CPU through the
		RPMSGIOC_ACQUIRE_WAKELOCK and RPMSGIOC_RELEASE_WAKELOCK ioctls.
		Both sides of the link must enable it.

config RPMSG_HEAP
	bool "rpmsg heap manage support"
	default n
	---help---
		This is for rpmsg heap manage, it can be used to allocate/free
		shm for slave.

config RPMSG_DUMP_LEVEL
	int "rpmsg dump level"
	default 2 if DEFAULT_SMALL
	default 3
	range 0 3
	---help---
		Control what rpmsg can dump:
		  0 - Disable: no dump support, RPMSGIOC_DUMP returns -ENOTTY
		  1 - Manual: dump on request only (RPMSGIOC_DUMP)
		  2 - Panic info: also a brief dump on panic, at the
		      PANIC_KERNEL_FINAL stage
		  3 - Panic verbose: also a full dump on panic

config RPMSG_POOL_COUNT
	int "rpmsg pool buffer count"
	default 0
	---help---
		This macro sets the count of rpmsg pool buffers, each pool
		can be used to allocate rpmsg buffers. 0 means disable
		rpmsg pool.

config RPMSG_POOL_SIZE
	int "rpmsg pool size"
	depends on RPMSG_POOL_COUNT != 0
	default 64
	---help---
		This macro sets the size of each rpmsg pool, which is used
		to allocate rpmsg buffers. The default value is 64 bytes.

endif # RPMSG

config RPMSG_ROUTER
	bool "rpmsg router support"
	default n
	---help---
		Rpmsg router driver for enabling communication
		without physical channels.

config RPMSG_PORT
	bool
	default n
	select RPMSG
	---help---
		Rpmsg port transport layer used for cross chip communication.

config RPMSG_PORT_SPI
	bool "Rpmsg SPI Port Driver Support"
	default n
	depends on SPI
	select RPMSG_PORT
	---help---
		Rpmsg SPI Port driver used for cross chip communication.

config RPMSG_PORT_SPI_SLAVE
	bool "Rpmsg SPI Slave Port Driver Support"
	default n
	select RPMSG_PORT
	---help---
		Rpmsg SPI Slave Port driver used for cross chip communication.

if RPMSG_PORT_SPI || RPMSG_PORT_SPI_SLAVE

config RPMSG_PORT_SPI_THREAD_PRIORITY
	int "Rpmsg SPI Port Thread Priority"
	default 224

config RPMSG_PORT_SPI_THREAD_STACKSIZE
	int "Rpmsg SPI Port Stack Size"
	default 4096

config RPMSG_PORT_SPI_CRC
	bool "Rpmsg SPI Port Use Checksum"
	default n
	---help---
		Check every frame with a 16-bit XOR checksum (xorsum16()). It
		catches corrupted framing at little cost, but it is not a CRC: it
		misses errors that flip the same bit in two 16-bit words.

config RPMSG_PORT_SPI_RX_THRESHOLD
	int "Rpmsg SPI Port Rx Buffer Threshold"
	default 50
	range 0 100

config RPMSG_PORT_SPI_PM_TIMEOUT
	int "Rpmsg SPI Port PM Stay Timeout in Milliseconds"
	default 1
	depends on PM

endif # RPMSG_PORT_SPI

config RPMSG_PORT_UART
	bool "Rpmsg Uart Port Driver Support"
	default n
	depends on SCHED_EVENTS
	select RPMSG_PORT
	---help---
		Rpmsg Uart Port driver used for cross chip communication.

if RPMSG_PORT_UART

config RPMSG_PORT_UART_RX_THREAD_PRIORITY
	int "Rpmsg UART Port RX Thread Priority"
	default 224

config RPMSG_PORT_UART_RX_THREAD_STACKSIZE
	int "Rpmsg UART Port RX Stack Size"
	default DEFAULT_TASK_STACKSIZE

config RPMSG_PORT_UART_TX_THREAD_PRIORITY
	int "Rpmsg UART Port TX Thread Priority"
	default 224

config RPMSG_PORT_UART_TX_THREAD_STACKSIZE
	int "Rpmsg UART Port TX Stack Size"
	default DEFAULT_TASK_STACKSIZE

config RPMSG_PORT_UART_CRC
	bool "Rpmsg UART Port Checksum Enable"
	default n
	---help---
		Check every frame with a 16-bit XOR checksum (xorsum16()). It
		catches corrupted framing at little cost, but it is not a CRC: it
		misses errors that flip the same bit in two 16-bit words.

config RPMSG_PORT_UART_COMPRESSION
	bool "Rpmsg UART Port LZF Compression"
	default n
	depends on LIBC_LZF
	---help---
		Enable LZF compression for rpmsg port uart data frames.
		Compresses payload before byte-escaping to reduce UART
		bandwidth usage. Both TX and RX sides must enable this.

config RPMSG_PORT_UART_DEBUG
	bool "Rpmsg UART DEBUG Enable"
	default n

endif # RPMSG_PORT_UART

config RPMSG_VIRTIO
	bool
	default n
	select RPMSG
	---help---
		The Rpmsg VirtIO Lite, VirtIO-Rpmsg and VHost-Rpmsg common
		part.

if RPMSG_VIRTIO

config RPMSG_VIRTIO_PM
	bool "RPMsg VirtIO power management"
	depends on PM
	default n
	---help---
		If TX/RX buffer is supplied and powered by each CPU.
		And when one CPU in DEEP sleep, then it's buffer will
		goto RAM-retention mode, can't access from another CPU.
		So, we provide this method to resolve this.

config RPMSG_VIRTIO_PM_AUTORELAX
	bool "RPMsg VirtIO pm autorelax"
	depends on RPMSG_VIRTIO_PM
	default y
	---help---
		Enable automatic power management wakelock relaxation using watchdog timer.

		When enabled, this option uses a watchdog timer to periodically check if
		there are any tx buffers is not returned by remote core. If the tx buffers
		are returned by remote core, the power management wakelock is automatically
		released, allowing the system to enter low-power states. If the tx buffers
		are still not returned by remote core, the wakelock is maintained and the
		timer is restarted.

		Autorelax feature can improve power efficiency in multi-core systems because
		it prevents unnecessary power consumption by reducing the times that system
		enter and leave low-power states.

config RPMSG_VIRTIO_START_SYNC
	bool "rpmsg virtio start devices synchronously"
	default n
	---help---
		By default probe defers the rpmsg device bring-up to the rpmsg work
		queue.  Enable this to run it inline instead, so the device is ready
		when probe returns, at the cost of blocking the probe caller.

		The bring-up then announces the local services from outside the
		rpmsg work queue, while the work queues of both cores answer each
		other's announcements and wait for tx buffers recursively.  If
		RPMSG_RECURSIVE_LIMIT is too small on either core, both cores wait
		for tx buffers forever: sim, with 17 services and 8 buffers, needs
		at least 4 on both cores.

endif # RPMSG_VIRTIO

