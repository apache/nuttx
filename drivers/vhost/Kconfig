#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config ARCH_HAVE_VHOST_IOMAP
	bool
	default n

config DRIVERS_VHOST
	bool
	select OPENAMP
	select SCHED_WORKQUEUE
	default n
	---help---
		Framework for implementing the DEVICE side of virtio links
		(the peer's driver uses us as the device, e.g. a remoteproc
		master like Linux).  rptun registers device-role vdevs from the
		resource table through this bus; without it such vdevs are
		rejected with -ENODEV.

config DRIVERS_VHOST_I2C
	bool "Virtual Host I2C Device Support"
	default n
	select I2C
	select DRIVERS_VHOST
	---help---
		Enable the vhost (device-side) I2C backend.  When an rptun resource
		table exposes a VirtIO I2C adapter device (device ID 34) in the
		device role, this driver serves the request virtqueue, decodes each
		request with the OASIS VirtIO I2C wire format, and forwards it to the
		local I2C device node named in the device config space.  This lets
		one NuttX instance export an I2C bus to a remote VirtIO I2C frontend,
		the native-VirtIO counterpart of the RPMSG I2C server.

config DRIVERS_VHOST_BLK
	bool "Virtual Host Blk Device Support"
	default n
	select DRIVERS_VHOST

if DRIVERS_VHOST_BLK

config DRIVERS_VHOST_BLK_PRIORITY
	int "vhost blk thread priority"
	default 224

config DRIVERS_VHOST_BLK_STACKSIZE
	int "vhost blk stack size"
	default 4096

endif # DRIVERS_VHOST_BLK

config DRIVERS_VHOST_RNG
	bool "Virtual Host Rng Device Support"
	default n
	select DRIVERS_VHOST

config DRIVERS_VHOST_NET
	bool "Virtual Host Network Device Support"
	default n
	depends on NETDEVICES
	select ARCH_HAVE_NETDEV_STATISTICS
	select DRIVERS_VHOST
	---help---
		Device-role virtio-net: expose this side as a network card to a
		peer processor running a standard virtio-net driver (e.g. Linux
		via remoteproc), providing a NuttX ethN interface.

config DRIVERS_VHOST_NET_MACADDR
	hex "vhost-net MAC address"
	default 0x0
	depends on DRIVERS_VHOST_NET
	---help---
		Fixed, software-assigned, locally administered MAC address
		presented to the network stack when the peer does not publish a
		valid address in the configuration space.  Set to 0 to generate
		a random locally administered unicast address instead.

config DRIVERS_VHOST_RPMSG
	bool "Virtual Host Rpmsg Device Support"
	default n
	select RPMSG_VIRTIO
	select DRIVERS_VHOST

config DRIVERS_VHOST_CAN
	bool "Virtual Host CAN Device Support"
	depends on NET_CAN
	default n
	select DRIVERS_VHOST
	---help---
		Enable the vhost CAN backend.  It bridges a VirtIO CAN device
		(device ID 36) to a local SocketCAN interface, forwarding frames
		between the peer's tx/rx/control virtqueues and the local bus.

config DRIVERS_VHOST_RPMB
	bool "Virtual Host RPMB Device Support"
	default n
	select DRIVERS_VHOST
	---help---
		Enable the vhost (device-side) RPMB backend.  It bridges a VirtIO
		RPMB device (device ID 22) to the RPMB partition of a local eMMC,
		forwarding the peer's RPMB frames as MMC_IOC_MULTI_CMD requests.
		The local block device is named by a path in the device config
		space, and the capacity and reliable-write count read from its
		EXT_CSD are published back through the config space.

if DRIVERS_VHOST_RPMB

config DRIVERS_VHOST_RPMB_PRIORITY
	int "vhost rpmb thread priority"
	default 224

config DRIVERS_VHOST_RPMB_STACKSIZE
	int "vhost rpmb stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config DRIVERS_VHOST_SERIAL
	bool "Virtual Host Serial Device Support"
	default n
	select DRIVERS_VHOST

if DRIVERS_VHOST_SERIAL

config DRIVERS_VHOST_SERIAL_PRIORITY
	int "vhost serial thread priority"
	default 224

config DRIVERS_VHOST_SERIAL_STACKSIZE
	int "vhost serial stack size"
	default DEFAULT_TASK_STACKSIZE

endif # DRIVERS_VHOST_SERIAL
