if ARCH_BOARD_ESP32S3_R8

config ESP32S3_R8_LCD
	bool "Enable ESP32-S3-R8 LCD"
	default n
	select ESP32S3_SPI2
	select SPI_CMDDATA
	select LCD
	select LCD_DEV
	select LCD_ST7789
	---help---
		Enable board LCD support, IC is LCD_ST7789V.

endif # ARCH_BOARD_ESP32S3_R8
