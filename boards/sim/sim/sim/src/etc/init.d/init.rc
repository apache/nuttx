#include <nuttx/config.h>
#include <nuttx/macro.h>

#ifdef CONFIG_SYSTEM_NSH
service console sh
   restart_period 1000
#endif

on init
#ifdef CONFIG_SYSTEM_NSH
#ifdef CONFIG_FS_TMPFS
   mount -t tmpfs /tmp
#elif defined(CONFIG_FS_FAT)
   mkrd -m CONFIG_ETC_FATDEVNO -s CONFIG_ETC_FATSECTSIZE CONFIG_ETC_FATNSECTORS
   mkfatfs CONCATENATE(/dev/ram, CONFIG_ETC_FATDEVNO)
   mount -t vfat CONCATENATE(/dev/ram, CONFIG_ETC_FATDEVNO) CONFIG_ETC_FATMOUNTPT
#endif
#ifdef CONFIG_FS_HOSTFS
   mount -t hostfs -o fs=. /data
#endif
   start console
#endif
