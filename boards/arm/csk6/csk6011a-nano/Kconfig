if ARCH_BOARD_CSK6011A_NANO
choice
	prompt "Console Mode"
	default CSK6_CONSOLE_UART0

config CSK6_CONSOLE_UART0
	bool "USART0 is a console port"
	select USART0_SERIALDRIVER

#TODO add support other port
endchoice # USART0 Mode
endif

