#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_FMU_V6XRT

choice
	prompt "Boot Flash"
	default FMU_V6XRT_QSPI_FLASH

config FMU_V6XRT_HYPER_FLASH
	bool "HYPER Flash"

config FMU_V6XRT_QSPI_FLASH
	bool "QSPI Flash"

endchoice # Boot Flash

config FMU_V6XRT_SDRAM
	bool "Enable SDRAM"
	default n
	select IMXRT_SEMC_INIT_DONE
	---help---
		Activate DCD configuration of SDRAM

config IMXRT1170_FLEXSPI_NOR
	bool "Enable FlexSPI NOR Storage"
	default n
	depends on IMXRT_FLEXSPI

config IMXRT1170_FLEXSPI_FRAM
	bool "Enable FlexSPI FRAM Storage"
	default n
	depends on IMXRT_FLEXSPI
	select MTD

endif
