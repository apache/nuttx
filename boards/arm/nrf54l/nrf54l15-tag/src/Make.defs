include $(TOPDIR)/Make.defs

CSRCS = nrf54l_boot.c nrf54l_bringup.c

ifeq ($(CONFIG_NRF54L_SPI2_MASTER),y)
CSRCS += nrf54l_spi.c
endif

ifeq ($(CONFIG_SYSTEM_I2CTOOL),y)
CSRCS += nrf54l_i2c.c
endif

ifeq ($(CONFIG_SENSORS),y)
CSRCS += nrf54l_sensors.c
endif

ifeq ($(CONFIG_ARCH_BUTTONS),y)
CSRCS += nrf54l_buttons.c
endif

ifeq ($(CONFIG_NRF54L_SAADC),y)
CSRCS += nrf54l_adc.c
endif

ifeq ($(CONFIG_ARCH_LEDS),y)
CSRCS += nrf54l_autoleds.c
else
CSRCS += nrf54l_userleds.c
endif
