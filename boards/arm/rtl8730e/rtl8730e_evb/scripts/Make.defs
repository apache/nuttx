include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/arch/arm/src/armv7-a/Toolchain.defs

LDSCRIPT = dramboot.ld

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

# NXFLAT module definitions

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)$(DELIM)binfmt$(DELIM)libnxflat$(DELIM)gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

# Flashing via SDK AmebaFlash.py
# Usage: make flash AMEBA_PORT=/dev/ttyUSB1 [AMEBA_BAUD=1500000]
#
# RTL8730E (AmebaSmart CA32) uses an ATF boot chain: NuttX runs as BL33
# inside a FIP.  The flash script packages nuttx.bin as BL33, combines it
# with the vendor KM0/KM4/ATF prefix stored in prebuilt/, and flashes two
# images: boot.bin @ 0x08000000 and app.bin @ 0x0803FC00.
#
# The ameba-rtos SDK is auto-fetched on the first build of any Ameba IC in
# this workspace; its AmebaFlash.py and RTL8730E_NOR.rdev profile are used.

AMEBA_BAUD ?= 1500000

# Let ameba_sdk.mk resolve the SDK path (auto-fetch if needed) and set
# AMEBA_COMMON_DIR / AMEBA_SDK.  ameba_board.mk then uses $(AMEBA_SDK) to
# locate fwlib sources and builds libameba_fwlib.a in PREBUILD.

include $(TOPDIR)$(DELIM)arch$(DELIM)arm$(DELIM)src$(DELIM)common$(DELIM)ameba$(DELIM)ameba_sdk.mk
include $(TOPDIR)$(DELIM)arch$(DELIM)arm$(DELIM)src$(DELIM)rtl8730e$(DELIM)ameba_board.mk

# lib_rom.a and the RTK toolchain's libgcc.a are compiled without VFP ABI
# flags; suppress the harmless mismatch so the linker does not abort on it
# whenever libameba_fwlib.a is in the link (GPIO, WiFi, or flash-FS config).
ifneq ($(filter y,$(CONFIG_AMEBA_GPIO) $(CONFIG_AMEBA_UART) $(CONFIG_RTL8730E_WIFI) $(CONFIG_RTL8730E_FLASH_FS)),)
LDFLAGS += --no-warn-mismatch
endif

define FLASH
	$(Q) AMEBA_PORT="$(AMEBA_PORT)" AMEBA_BAUD="$(AMEBA_BAUD)" \
		sh $(AMEBA_COMMON_DIR)$(DELIM)tools$(DELIM)ameba_smart_flash.sh \
		$(AMEBA_SDK) $(AMEBA_PREBUILT) $(TOPDIR)$(DELIM)nuttx.bin
endef
