source "net/bt/audio/Kconfig.micp"
source "net/bt/audio/Kconfig.csip"
source "net/bt/audio/Kconfig.tbs"
source "net/bt/audio/Kconfig.mcs"
source "net/bt/audio/Kconfig.has"
source "net/bt/audio/Kconfig.mpl"
source "net/bt/audio/Kconfig.mctl"
source "net/bt/audio/Kconfig.cap"
source "net/bt/audio/Kconfig.tmap"
source "net/bt/audio/Kconfig.gmap"
source "net/bt/audio/Kconfig.pbp"

module = BT_AUDIO
module-str = "Bluetooth Audio"
# source "subsys/logging/Kconfig.template.log_config"

endif # BT_AUDIO
