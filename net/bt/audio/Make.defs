ifeq ($(CONFIG_BT_AUDIO),y)

BT_CSRCS += bt/audio/audio.c

ifneq ($(CONFIG_BT_VOCS)$(CONFIG_BT_VOCS_CLIENT),)
BT_CSRCS += bt/audio/vocs.c
endif
ifeq ($(CONFIG_BT_VOCS_CLIENT),y)
BT_CSRCS += bt/audio/vocs_client.c
endif

ifneq ($(CONFIG_BT_AICS)$(CONFIG_BT_AICS_CLIENT),)
BT_CSRCS += bt/audio/aics.c
endif
ifeq ($(CONFIG_BT_AICS_CLIENT),y)
BT_CSRCS += bt/audio/aics_client.c
endif

ifeq ($(CONFIG_BT_VCP_VOL_REND),y)
BT_CSRCS += bt/audio/vcp_vol_rend.c
endif
ifeq ($(CONFIG_BT_VCP_VOL_CTLR),y)
BT_CSRCS += bt/audio/vcp_vol_ctlr.c
endif

ifeq ($(CONFIG_BT_MICP_MIC_DEV),y)
BT_CSRCS += bt/audio/micp_mic_dev.c
endif
ifeq ($(CONFIG_BT_MICP_MIC_CTLR),y)
BT_CSRCS += bt/audio/micp_mic_ctlr.c
endif

ifeq ($(CONFIG_BT_CONN),y)
BT_CSRCS += bt/audio/ccid.c
endif

ifeq ($(CONFIG_BT_CSIP_SET_MEMBER),y)
BT_CSRCS += bt/audio/csip_set_member.c
endif
ifeq ($(CONFIG_BT_CSIP_SET_COORDINATOR),y)
BT_CSRCS += bt/audio/csip_set_coordinator.c
endif
ifneq ($(CONFIG_BT_CSIP_SET_MEMBER)$(CONFIG_BT_CSIP_SET_COORDINATOR),)
BT_CSRCS += bt/audio/csip_crypto.c
endif

ifeq ($(CONFIG_BT_TBS),y)
BT_CSRCS += bt/audio/tbs.c
endif
ifeq ($(CONFIG_BT_TBS_CLIENT),y)
BT_CSRCS += bt/audio/tbs_client.c
endif
ifeq ($(CONFIG_BT_MCC),y)
BT_CSRCS += bt/audio/mcc.c
endif
ifeq ($(CONFIG_BT_MCS),y)
BT_CSRCS += bt/audio/mcs.c
endif
ifeq ($(CONFIG_BT_MPL),y)
BT_CSRCS += bt/audio/mpl.c
endif
ifeq ($(CONFIG_MCTL),y)
BT_CSRCS += bt/audio/media_proxy.c
endif

ifeq ($(CONFIG_BT_ASCS),y)
BT_CSRCS += bt/audio/ascs.c
endif
ifeq ($(CONFIG_BT_PACS),y)
BT_CSRCS += bt/audio/pacs.c
endif
ifeq ($(CONFIG_BT_BAP_STREAM),y)
BT_CSRCS += bt/audio/bap_stream.c bt/audio/codec.c bt/audio/bap_iso.c
endif
ifeq ($(CONFIG_BT_BAP_BASE),y)
BT_CSRCS += bt/audio/bap_base.c
endif
ifeq ($(CONFIG_BT_BAP_UNICAST_SERVER),y)
BT_CSRCS += bt/audio/bap_unicast_server.c
endif
ifeq ($(CONFIG_BT_BAP_UNICAST_CLIENT),y)
BT_CSRCS += bt/audio/bap_unicast_client.c
endif
ifeq ($(CONFIG_BT_BAP_BROADCAST_SOURCE),y)
BT_CSRCS += bt/audio/bap_broadcast_source.c
endif
ifeq ($(CONFIG_BT_BAP_BROADCAST_SINK),y)
BT_CSRCS += bt/audio/bap_broadcast_sink.c
endif
ifeq ($(CONFIG_BT_BAP_SCAN_DELEGATOR),y)
BT_CSRCS += bt/audio/bap_scan_delegator.c
endif
ifeq ($(CONFIG_BT_BAP_BROADCAST_ASSISTANT),y)
BT_CSRCS += bt/audio/bap_broadcast_assistant.c
endif
ifeq ($(CONFIG_BT_CCP_CALL_CONTROL_CLIENT),y)
BT_CSRCS += bt/audio/ccp_call_control_client.c
endif
ifeq ($(CONFIG_BT_CCP_CALL_CONTROL_SERVER),y)
BT_CSRCS += bt/audio/ccp_call_control_server.c
endif
ifeq ($(CONFIG_BT_HAS),y)
BT_CSRCS += bt/audio/has.c
endif
ifeq ($(CONFIG_BT_HAS_CLIENT),y)
BT_CSRCS += bt/audio/has_client.c
endif
ifeq ($(CONFIG_BT_CAP),y)
BT_CSRCS += bt/audio/cap_stream.c
endif
ifeq ($(CONFIG_BT_CAP_ACCEPTOR),y)
BT_CSRCS += bt/audio/cap_acceptor.c
endif
ifeq ($(CONFIG_BT_CAP_INITIATOR),y)
BT_CSRCS += bt/audio/cap_initiator.c
endif
ifeq ($(CONFIG_BT_CAP_COMMANDER),y)
BT_CSRCS += bt/audio/cap_commander.c
endif
ifeq ($(CONFIG_BT_CAP_HANDOVER),y)
BT_CSRCS += bt/audio/cap_handover.c
endif
ifneq ($(CONFIG_BT_CAP_INITIATOR_UNICAST)$(CONFIG_BT_CAP_COMMANDER),)
BT_CSRCS += bt/audio/cap_common.c
endif
ifeq ($(CONFIG_BT_TMAP),y)
BT_CSRCS += bt/audio/tmap.c
endif
ifeq ($(CONFIG_BT_GMAP),y)
BT_CSRCS += bt/audio/gmap_client.c bt/audio/gmap_server.c
endif
ifeq ($(CONFIG_BT_PBP),y)
BT_CSRCS += bt/audio/pbp.c
endif

ifeq ($(CONFIG_BT_SHELL),y)
ifeq ($(CONFIG_BT_CCP_CALL_CONTROL_SERVER),y)
BT_CSRCS += bt/audio/shell/ccp_call_control_server.c
endif
ifeq ($(CONFIG_BT_CCP_CALL_CONTROL_CLIENT),y)
BT_CSRCS += bt/audio/shell/ccp_call_control_client.c
endif
ifeq ($(CONFIG_BT_VCP_VOL_REND),y)
BT_CSRCS += bt/audio/shell/vcp_vol_rend.c
endif
ifeq ($(CONFIG_BT_VCP_VOL_CTLR),y)
BT_CSRCS += bt/audio/shell/vcp_vol_ctlr.c
endif
ifeq ($(CONFIG_BT_MICP_MIC_DEV),y)
BT_CSRCS += bt/audio/shell/micp_mic_dev.c
endif
ifeq ($(CONFIG_BT_MICP_MIC_CTLR),y)
BT_CSRCS += bt/audio/shell/micp_mic_ctlr.c
endif
ifeq ($(CONFIG_BT_CSIP_SET_MEMBER),y)
BT_CSRCS += bt/audio/shell/csip_set_member.c
endif
ifeq ($(CONFIG_BT_CSIP_SET_COORDINATOR),y)
BT_CSRCS += bt/audio/shell/csip_set_coordinator.c
endif
ifeq ($(CONFIG_BT_TBS),y)
BT_CSRCS += bt/audio/shell/tbs.c
endif
ifeq ($(CONFIG_BT_TBS_CLIENT),y)
BT_CSRCS += bt/audio/shell/tbs_client.c
endif
ifeq ($(CONFIG_BT_MPL),y)
BT_CSRCS += bt/audio/shell/mpl.c
endif
ifeq ($(CONFIG_BT_MCC),y)
BT_CSRCS += bt/audio/shell/mcc.c
endif
ifeq ($(CONFIG_BT_MCS),y)
BT_CSRCS += bt/audio/shell/media_controller.c
endif
ifeq ($(CONFIG_BT_HAS_PRESET_SUPPORT),y)
BT_CSRCS += bt/audio/shell/has.c
endif
ifeq ($(CONFIG_BT_CAP_ACCEPTOR),y)
BT_CSRCS += bt/audio/shell/cap_acceptor.c
endif
ifeq ($(CONFIG_BT_CAP_INITIATOR),y)
BT_CSRCS += bt/audio/shell/cap_initiator.c
endif
ifeq ($(CONFIG_BT_CAP_COMMANDER),y)
BT_CSRCS += bt/audio/shell/cap_commander.c
endif
ifeq ($(CONFIG_BT_CAP_HANDOVER),y)
BT_CSRCS += bt/audio/shell/cap_handover.c
endif
ifeq ($(CONFIG_BT_HAS_CLIENT),y)
BT_CSRCS += bt/audio/shell/has_client.c
endif
ifeq ($(CONFIG_BT_TMAP),y)
BT_CSRCS += bt/audio/shell/tmap.c
endif
ifeq ($(CONFIG_BT_GMAP),y)
BT_CSRCS += bt/audio/shell/gmap.c
endif
ifeq ($(CONFIG_BT_BAP_STREAM),y)
BT_CSRCS += bt/audio/shell/bap.c
endif
ifneq ($(CONFIG_LIBLC3)$(CONFIG_USBD_AUDIO2_CLASS),)
ifeq ($(CONFIG_LIBLC3),y)
ifeq ($(CONFIG_USBD_AUDIO2_CLASS),y)
BT_CSRCS += bt/audio/shell/bap_usb.c
endif
endif
endif
ifeq ($(CONFIG_BT_BAP_SCAN_DELEGATOR),y)
BT_CSRCS += bt/audio/shell/bap_scan_delegator.c
endif
ifeq ($(CONFIG_BT_BAP_BROADCAST_ASSISTANT),y)
BT_CSRCS += bt/audio/shell/bap_broadcast_assistant.c
endif
ifeq ($(CONFIG_BT_PBP),y)
BT_CSRCS += bt/audio/shell/pbp.c
endif
endif

VPATH += bt/audio bt/audio/shell
DEPPATH += --dep-path bt/audio --dep-path bt/audio/shell
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/audio

endif
