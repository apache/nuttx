ifeq ($(CONFIG_BT_MESH),y)

BT_CSRCS += bt/mesh/main.c bt/mesh/cfg.c bt/mesh/adv.c bt/mesh/beacon.c
BT_CSRCS += bt/mesh/net.c bt/mesh/subnet.c bt/mesh/app_keys.c
BT_CSRCS += bt/mesh/heartbeat.c bt/mesh/crypto.c bt/mesh/crypto_psa.c
BT_CSRCS += bt/mesh/access.c bt/mesh/msg.c bt/mesh/cfg_srv.c
BT_CSRCS += bt/mesh/health_srv.c bt/mesh/va.c bt/mesh/transport.c

ifeq ($(CONFIG_BT_MESH_ADV_LEGACY),y)
BT_CSRCS += bt/mesh/adv_legacy.c
endif
ifeq ($(CONFIG_BT_MESH_ADV_EXT),y)
BT_CSRCS += bt/mesh/adv_ext.c
endif
ifeq ($(CONFIG_BT_SETTINGS),y)
BT_CSRCS += bt/mesh/settings.c
endif
ifeq ($(CONFIG_BT_MESH_RPL_STORAGE_MODE_SETTINGS),y)
BT_CSRCS += bt/mesh/rpl.c
endif
ifeq ($(CONFIG_BT_MESH_LOW_POWER),y)
BT_CSRCS += bt/mesh/lpn.c
endif
ifeq ($(CONFIG_BT_MESH_FRIEND),y)
BT_CSRCS += bt/mesh/friend.c
endif
ifeq ($(CONFIG_BT_MESH_PROV),y)
BT_CSRCS += bt/mesh/prov.c
endif
ifeq ($(CONFIG_BT_MESH_PROVISIONEE),y)
BT_CSRCS += bt/mesh/provisionee.c
endif
ifeq ($(CONFIG_BT_MESH_PROVISIONER),y)
BT_CSRCS += bt/mesh/provisioner.c
endif
ifeq ($(CONFIG_BT_MESH_PB_ADV),y)
BT_CSRCS += bt/mesh/pb_adv.c
endif
ifeq ($(CONFIG_BT_MESH_PB_GATT_COMMON),y)
BT_CSRCS += bt/mesh/pb_gatt.c
endif
ifeq ($(CONFIG_BT_MESH_PB_GATT),y)
BT_CSRCS += bt/mesh/pb_gatt_srv.c
endif
ifeq ($(CONFIG_BT_MESH_PB_GATT_CLIENT),y)
BT_CSRCS += bt/mesh/pb_gatt_cli.c
endif
ifeq ($(CONFIG_BT_MESH_GATT_CLIENT),y)
BT_CSRCS += bt/mesh/gatt_cli.c
endif
ifeq ($(CONFIG_BT_MESH_PROXY_CLIENT),y)
BT_CSRCS += bt/mesh/proxy_cli.c
endif
ifeq ($(CONFIG_BT_MESH_GATT_PROXY),y)
BT_CSRCS += bt/mesh/proxy_srv.c
endif
ifeq ($(CONFIG_BT_MESH_GATT),y)
BT_CSRCS += bt/mesh/proxy_msg.c
endif
ifeq ($(CONFIG_BT_MESH_CFG_CLI),y)
BT_CSRCS += bt/mesh/cfg_cli.c
endif
ifeq ($(CONFIG_BT_MESH_HEALTH_CLI),y)
BT_CSRCS += bt/mesh/health_cli.c
endif
ifeq ($(CONFIG_BT_MESH_SAR_CFG_CLI),y)
BT_CSRCS += bt/mesh/sar_cfg_cli.c
endif
ifeq ($(CONFIG_BT_MESH_SAR_CFG_SRV),y)
BT_CSRCS += bt/mesh/sar_cfg_srv.c
endif
ifeq ($(CONFIG_BT_MESH_SAR_CFG),y)
BT_CSRCS += bt/mesh/sar_cfg.c
endif
ifeq ($(CONFIG_BT_MESH_OP_AGG_SRV),y)
BT_CSRCS += bt/mesh/op_agg_srv.c
endif
ifeq ($(CONFIG_BT_MESH_OP_AGG_CLI),y)
BT_CSRCS += bt/mesh/op_agg_cli.c
endif
ifeq ($(CONFIG_BT_MESH_OP_AGG),y)
BT_CSRCS += bt/mesh/op_agg.c
endif
ifeq ($(CONFIG_BT_MESH_LARGE_COMP_DATA_SRV),y)
BT_CSRCS += bt/mesh/large_comp_data_srv.c
endif
ifeq ($(CONFIG_BT_MESH_LARGE_COMP_DATA_CLI),y)
BT_CSRCS += bt/mesh/large_comp_data_cli.c
endif
ifeq ($(CONFIG_BT_MESH_PRIV_BEACON_SRV),y)
BT_CSRCS += bt/mesh/priv_beacon_srv.c
endif
ifeq ($(CONFIG_BT_MESH_PRIV_BEACON_CLI),y)
BT_CSRCS += bt/mesh/priv_beacon_cli.c
endif
ifeq ($(CONFIG_BT_MESH_SELF_TEST),y)
BT_CSRCS += bt/mesh/test.c
endif
ifeq ($(CONFIG_BT_MESH_CDB),y)
BT_CSRCS += bt/mesh/cdb.c
endif
ifeq ($(CONFIG_BT_MESH_BLOB_SRV),y)
BT_CSRCS += bt/mesh/blob_srv.c
endif
ifeq ($(CONFIG_BT_MESH_BLOB_CLI),y)
BT_CSRCS += bt/mesh/blob_cli.c
endif
ifeq ($(CONFIG_BT_MESH_BLOB_IO_FLASH),y)
BT_CSRCS += bt/mesh/blob_io_flash.c
endif
ifeq ($(CONFIG_BT_MESH_DFU_CLI),y)
BT_CSRCS += bt/mesh/dfu_cli.c
endif
ifeq ($(CONFIG_BT_MESH_DFU_SRV),y)
BT_CSRCS += bt/mesh/dfu_srv.c
endif
ifeq ($(CONFIG_BT_MESH_DFD_SRV),y)
BT_CSRCS += bt/mesh/dfd_srv.c
endif
ifeq ($(CONFIG_BT_MESH_DFU_SLOTS),y)
BT_CSRCS += bt/mesh/dfu_slot.c
endif
ifeq ($(CONFIG_BT_MESH_DFU_METADATA),y)
BT_CSRCS += bt/mesh/dfu_metadata.c
endif
ifeq ($(CONFIG_BT_MESH_RPR_CLI),y)
BT_CSRCS += bt/mesh/rpr_cli.c
endif
ifeq ($(CONFIG_BT_MESH_RPR_SRV),y)
BT_CSRCS += bt/mesh/rpr_srv.c
endif
ifeq ($(CONFIG_BT_MESH_OD_PRIV_PROXY_CLI),y)
BT_CSRCS += bt/mesh/od_priv_proxy_cli.c
endif
ifeq ($(CONFIG_BT_MESH_OD_PRIV_PROXY_SRV),y)
BT_CSRCS += bt/mesh/od_priv_proxy_srv.c bt/mesh/sol_pdu_rpl_srv.c
endif
ifeq ($(CONFIG_BT_MESH_SOL_PDU_RPL_CLI),y)
BT_CSRCS += bt/mesh/sol_pdu_rpl_cli.c
endif
ifeq ($(CONFIG_BT_MESH_BRG_CFG_CLI),y)
BT_CSRCS += bt/mesh/brg_cfg_cli.c
endif
ifeq ($(CONFIG_BT_MESH_BRG_CFG_SRV),y)
BT_CSRCS += bt/mesh/brg_cfg_srv.c bt/mesh/brg_cfg.c
endif
ifeq ($(CONFIG_BT_MESH_SOLICITATION),y)
BT_CSRCS += bt/mesh/solicitation.c
endif
ifeq ($(CONFIG_BT_MESH_STATISTIC),y)
BT_CSRCS += bt/mesh/statistic.c
endif
ifeq ($(CONFIG_BT_MESH_ACCESS_DELAYABLE_MSG),y)
BT_CSRCS += bt/mesh/delayable_msg.c
endif
ifeq ($(CONFIG_BT_TESTING),y)
BT_CSRCS += bt/mesh/testing.c
endif

ifeq ($(CONFIG_BT_MESH_SHELL),y)
BT_CSRCS += bt/mesh/shell/shell.c bt/mesh/shell/utils.c
ifeq ($(CONFIG_BT_MESH_SHELL_HEALTH_CLI),y)
BT_CSRCS += bt/mesh/shell/health.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_CFG_CLI),y)
BT_CSRCS += bt/mesh/shell/cfg.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_LARGE_COMP_DATA_CLI),y)
BT_CSRCS += bt/mesh/shell/large_comp_data.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_OP_AGG_CLI),y)
BT_CSRCS += bt/mesh/shell/op_agg.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_PRIV_BEACON_CLI),y)
BT_CSRCS += bt/mesh/shell/priv_beacon.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_RPR_CLI),y)
BT_CSRCS += bt/mesh/shell/rpr.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_SAR_CFG_CLI),y)
BT_CSRCS += bt/mesh/shell/sar.c
endif
ifneq ($(CONFIG_BT_MESH_SHELL_BLOB_CLI)$(CONFIG_BT_MESH_SHELL_BLOB_SRV)$(CONFIG_BT_MESH_SHELL_BLOB_IO_FLASH),)
BT_CSRCS += bt/mesh/shell/blob.c
endif
ifneq ($(CONFIG_BT_MESH_SHELL_DFU_SLOT)$(CONFIG_BT_MESH_SHELL_DFU_METADATA)$(CONFIG_BT_MESH_SHELL_DFU_CLI)$(CONFIG_BT_MESH_SHELL_DFU_SRV),)
BT_CSRCS += bt/mesh/shell/dfu.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_DFD_SRV),y)
BT_CSRCS += bt/mesh/shell/dfd.c
endif
ifeq ($(CONFIG_BT_MESH_OD_PRIV_PROXY_CLI),y)
BT_CSRCS += bt/mesh/shell/od_priv_proxy.c
endif
ifeq ($(CONFIG_BT_MESH_SOL_PDU_RPL_CLI),y)
BT_CSRCS += bt/mesh/shell/sol_pdu_rpl.c
endif
ifeq ($(CONFIG_BT_MESH_SHELL_BRG_CFG_CLI),y)
BT_CSRCS += bt/mesh/shell/brg_cfg.c
endif
endif

VPATH += bt/mesh bt/mesh/shell
DEPPATH += --dep-path bt/mesh --dep-path bt/mesh/shell
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/mesh

endif
