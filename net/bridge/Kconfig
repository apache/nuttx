#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig NET_BRIDGE
	bool "Ethernet bridge support"
	default n
	depends on NET_ETHERNET && SCHED_LPWORK
	depends on IOB_NCHAINS != 0
	select NETDEV_IFINDEX
	---help---
		Enable a transparent, learning Ethernet bridge (IEEE 802.1D without
		spanning tree).  A bridge is a virtual network device (e.g. br0)
		created with the SIOCBRADDBR ioctl.  Ethernet (or IEEE 802.11)
		devices are added to it as ports with SIOCBRADDIF.  Frames received
		on a port are forwarded to the other ports based on a filtering
		database of learned MAC addresses, and frames for the local host are
		passed to the network stack through the bridge device, which holds
		the IP configuration.

		There is no spanning tree protocol: the network must not contain
		loops through the bridge.

		Port devices must accept frames for foreign destination MAC
		addresses (promiscuous mode, see NET_PROMISCUOUS) to forward unicast
		traffic.  Devices using the upper-half network driver interface pass
		every received frame to the bridge.  Other devices only pass the
		frames that they give to ipv4_input(), ipv6_input() or arp_input().

		The bridge needs IOBs that the TCP receive window does not account
		for: frames waiting in the port queues and, for drivers that use a
		flat buffer, a copy of every received frame.  When a TCP sender
		fills the advertised window, no IOB may be left for them and
		received frames are dropped, which makes TCP throughput collapse.
		Set IOB_THROTTLE to reserve IOBs for the bridge, for example
		NET_BRIDGE_TXQ_LEN.

if NET_BRIDGE

config NET_BRIDGE_MAX_PORTS
	int "Maximum number of ports per bridge"
	default 4
	range 2 32

config NET_BRIDGE_FDB_SIZE
	int "Filtering database size"
	default 32
	---help---
		Number of MAC addresses that each bridge can learn.  When the table
		is full, the oldest entry is replaced.

config NET_BRIDGE_AGEING_TIME
	int "Filtering database ageing time (seconds)"
	default 300
	---help---
		A learned MAC address is forgotten after this many seconds without
		receiving a frame from it.

config NET_BRIDGE_TXQ_LEN
	int "Port transmit queue length"
	default 16
	---help---
		Maximum number of frames waiting to be sent on each port.  Frames
		are dropped when the queue is full.  Each queued frame holds at
		least one IOB.

endif # NET_BRIDGE
