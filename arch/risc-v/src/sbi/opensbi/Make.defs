DEPPATH += --dep-path sbi/opensbi/opensbi-3rdparty
VPATH += :sbi/opensbi/opensbi-3rdparty

SBI_CSRCS  = $(wildcard sbi/opensbi/opensbi-3rdparty/lib/sbi/*.c)
SBI_CSRCS += sbi/opensbi/opensbi-3rdparty/lib/utils/ipi/aclint_mswi.c
SBI_CSRCS += sbi/opensbi/opensbi-3rdparty/lib/utils/irqchip/plic.c
SBI_CSRCS += sbi/opensbi/opensbi-3rdparty/lib/utils/timer/aclint_mtimer.c

EXCLUDED_FILES  = sbi/opensbi/opensbi-3rdparty/lib/sbi/sbi_pmu.c
EXCLUDED_FILES += sbi/opensbi/opensbi-3rdparty/lib/sbi/sbi_ecall_dbcn.c

TMPVAR := $(SBI_CSRCS)
SBI_CSRCS = $(filter-out $(EXCLUDED_FILES), $(TMPVAR))

SBI_ASRCS += sbi/opensbi/opensbi-3rdparty/lib/sbi/sbi_expected_trap.S
SBI_ASRCS += sbi/opensbi/opensbi-3rdparty/lib/sbi/sbi_hfence.S
SBI_ASRCS += sbi/opensbi/opensbi-3rdparty/lib/sbi/riscv_hardfp.S

INCLUDES  += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)sbi$(DELIM)opensbi$(DELIM)opensbi-3rdparty$(DELIM)include

SBI_DIR   := sbi/opensbi

OPENSBI_UNPACK  = opensbi-3rdparty
OPENSBI_COMMIT  = fbaaafe808f3da7745760d757c436ef1b293d3ed
OPENSBI_URL     = https://github.com/riscv-software-src/opensbi/tarball
OPENSBI_TARBALL = opensbi.tar.gz
OPENSBI_DIR     = riscv-software-src-opensbi-fbaaafe

$(OPENSBI_TARBALL):
	$(call DOWNLOAD,$(OPENSBI_URL),$(OPENSBI_COMMIT),sbi/opensbi/$(OPENSBI_TARBALL))

.opensbi_unpack: $(OPENSBI_TARBALL)
	$(Q) echo "Unpacking: OpenSBI"
	$(Q) tar xzf sbi/opensbi/$(OPENSBI_TARBALL) -C sbi/opensbi
	$(Q) mv sbi/opensbi/$(OPENSBI_DIR) sbi/opensbi/$(OPENSBI_UNPACK)
	$(Q) touch sbi/opensbi/.opensbi_unpack
	$(Q) sbi/opensbi/$(OPENSBI_UNPACK)/scripts/carray.sh -i sbi/opensbi/$(OPENSBI_UNPACK)/lib/sbi/sbi_ecall_exts.carray -l "ecall_base ecall_hsm ecall_ipi ecall_rfence ecall_time ecall_vendor" > sbi/opensbi/$(OPENSBI_UNPACK)/lib/sbi/sbi_ecall_exts.c

ifeq ($(wildcard sbi/opensbi/$(OPENSBI_UNPACK)/.git),)
context:: .opensbi_unpack

distclean::
	$(call DELFILE, sbi/opensbi/.opensbi_unpack)
	$(call DELFILE, sbi/opensbi/$(OPENSBI_TARBALL))
	$(call DELDIR, sbi/opensbi/$(OPENSBI_UNPACK))
endif
