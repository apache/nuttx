.PHONY: rustsbi rustsbi_clean rustsbi_distclean
.DEFAULT_GOAL := all

RUSTSBI_TARGET_DIR = $(TOPDIR)$(DELIM)arch$(DELIM)risc-v$(DELIM)src$(DELIM)sbi$(DELIM)rustsbi$(DELIM)target
RUSTSBI_ARTIFACT_DIR = $(RUSTSBI_TARGET_DIR)$(DELIM)$(CONFIG_RUSTSBI_TARGET)$(DELIM)release

nuttx$(EXEEXT): rustsbi

rustsbi:
ifeq ($(CONFIG_WINDOWS_NATIVE),y)
	$(Q) cd /d "$(TOPDIR)\$(patsubst "%",%,$(CONFIG_RUSTSBI_DIR))" && set "MAKEFLAGS=" && set "CARGO_TARGET_DIR=$(RUSTSBI_TARGET_DIR)" && cargo prototyper build --target "$(CONFIG_RUSTSBI_TARGET)" --config-file "$(CONFIG_RUSTSBI_CONFIG)" dynamic
	$(Q) copy /Y "$(RUSTSBI_ARTIFACT_DIR)\rustsbi-prototyper-dynamic.elf" "$(TOPDIR)\nuttx-rustsbi.elf"
else
	$(Q) cd "$(TOPDIR)/$(patsubst "%",%,$(CONFIG_RUSTSBI_DIR))" && \
		MAKEFLAGS= CARGO_TARGET_DIR="$(RUSTSBI_TARGET_DIR)" cargo prototyper build --target "$(CONFIG_RUSTSBI_TARGET)" --config-file "$(CONFIG_RUSTSBI_CONFIG)" dynamic
	$(Q) cp -f "$(RUSTSBI_ARTIFACT_DIR)/rustsbi-prototyper-dynamic.elf" "$(TOPDIR)/nuttx-rustsbi.elf"
endif
ifneq ($(NUTTX_MANIFEST),)
	$(Q) echo nuttx-rustsbi.elf >> "$(NUTTX_MANIFEST)"
endif

clean: rustsbi_clean

rustsbi_clean:
	$(call DELFILE, $(TOPDIR)$(DELIM)nuttx-rustsbi.elf)

distclean:: rustsbi_distclean

rustsbi_distclean:
	$(call DELDIR, $(RUSTSBI_TARGET_DIR))
