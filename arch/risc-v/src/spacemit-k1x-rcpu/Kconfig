comment "SpacemiT K1 RCPU Configuration Options"

config SPACEMIT_K1X_RCPU_CONSOLE_BAUD
	int "RCPU console baud rate"
	default 115200
	depends on ARCH_CHIP_SPACEMIT_K1X_RCPU
	---help---
		Line speed of the RCPU console UART.


config SPACEMIT_K1X_RCPU_CONSOLE_CLOCK
	int "RCPU console UART functional clock (Hz)"
	default 24000000
	depends on ARCH_CHIP_SPACEMIT_K1X_RCPU
	---help---
		Functional clock of the RCPU console UART in Hz.  The baud
		divisor is computed from this value.


config SPACEMIT_K1X_RCPU_SYSTIMER_FREQ
	int "RCPU system timer frequency (Hz)"
	default 120000
	depends on ARCH_CHIP_SPACEMIT_K1X_RCPU
	---help---
		Frequency of the machine timer that drives the system tick.

config SPACEMIT_K1X_RCPU_ECLIC_NUM_IRQS
	int "Number of ECLIC interrupt sources"
	default 84
	depends on ARCH_CHIP_SPACEMIT_K1X_RCPU
	---help---
		Number of interrupt sources in the Nuclei ECLIC.  The ECLIC
		reports the id of its highest source in INFO.NUMINT, so this is
		NUMINT + 1.
