include common/Make.defs

# The K1 RCPU is a Nuclei N308: 32-bit, ECLIC interrupts, no PLIC and no
# CLINT.  The ECLIC and the machine timer live inside the Nuclei IRegion,
# whose base address is discovered at run time.

# The HEAD assembly file is linked first so that the trap vector lands at the
# very start of the image.

HEAD_ASRC = spacemit_k1x_rcpu_head.S

# Chip specific C sources

CHIP_CSRCS  = spacemit_k1x_rcpu_clockconfig.c
CHIP_CSRCS += spacemit_k1x_rcpu_irq.c spacemit_k1x_rcpu_irq_dispatch.c
CHIP_CSRCS += spacemit_k1x_rcpu_lowputc.c spacemit_k1x_rcpu_serial.c
CHIP_CSRCS += spacemit_k1x_rcpu_start.c spacemit_k1x_rcpu_timerisr.c

# An interrupt driven serial driver is not part of this revision.  Console
# output goes through riscv_lowputc(), which is enough to bring the system up
# and to report a fault, and it avoids carrying a second copy of a 16550
# driver until the PXA variant can be folded into drivers/serial/uart_16550.c
# rather than duplicated here.
