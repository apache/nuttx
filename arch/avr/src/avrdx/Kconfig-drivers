config AVR_AVRDX_DRIVER_WS2812
	bool "Enable driver for WS2812 LEDs"
	default false
	depends on AVR_AVRDX_SWINT
	depends on AVRDX_HIGH_PRIO_INTERRUPTS
	depends on WS2812
	depends on WS2812_NON_SPI_DRIVER
	depends on BOARD_LATE_INITIALIZE
	---help---
		Enable this to build lower-half driver for WS2812 LED.

		This driver uses a concept of "lanes". A lane is a set of WS2812
		LEDs connected serially and driven from single hardware device
		(peripheral) on the MCU side.

		You need to select at least one peripheral to use this driver.
		Selected peripheral cannot be used by its regular driver and
		high priority interrupts will be enabled for it. (Or at least
		for its output-related interrupt.)

config AVR_AVRDX_WS2812_USART0
