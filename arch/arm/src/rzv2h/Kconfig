menu "RX FIFO 0"
	depends on RZV2H_CANFD

choice
	prompt "Enable"
	default RZV2H_CANFD_RXFIFO0_DISABLED

config RZV2H_CANFD_RXFIFO0_DISABLED
	bool "Disabled"

config RZV2H_CANFD_RXFIFO0_ENABLED
	bool "Enabled"

endchoice # RX FIFO 0 Enable

config RZV2H_CANFD_RXFIFO0_ENABLE
	int
	range 0 1
	default 0 if RZV2H_CANFD_RXFIFO0_DISABLED
	default 1 if RZV2H_CANFD_RXFIFO0_ENABLED

choice
	prompt "Interrupt Mode"
	default RZV2H_CANFD_RXFIFO0_INT_MODE_EVERY_FRAME

config RZV2H_CANFD_RXFIFO0_INT_MODE_DISABLE
	bool "Disable"

config RZV2H_CANFD_RXFIFO0_INT_MODE_THRESHOLD
	bool "At Threshold Value"

config RZV2H_CANFD_RXFIFO0_INT_MODE_EVERY_FRAME
	bool "Every Frame"

endchoice # RX FIFO 0 Interrupt Mode

config RZV2H_CANFD_RXFIFO0_INT_MODE
	int
	range 0 2
	default 0 if RZV2H_CANFD_RXFIFO0_INT_MODE_DISABLE
	default 1 if RZV2H_CANFD_RXFIFO0_INT_MODE_THRESHOLD
	default 2 if RZV2H_CANFD_RXFIFO0_INT_MODE_EVERY_FRAME

config RZV2H_CANFD_RXFIFO0_INT_THRESHOLD
	int "Interrupt Threshold"
	default 3
	range 0 7
	---help---
		0=1/8, 1=1/4, 2=3/8, 3=1/2, 4=5/8, 5=3/4, 6=7/8, 7=Full.

config RZV2H_CANFD_RXFIFO0_PAYLOAD
	int "Payload Size"
	default 7
	range 0 7
	---help---
		0=8, 1=12, 2=16, 3=20, 4=24, 5=32, 6=48, 7=64 bytes.

config RZV2H_CANFD_RXFIFO0_DEPTH
	int "Depth"
	default 3
	range 1 7
	---help---
		1=4, 2=8, 3=16, 4=32, 5=48, 6=64, 7=128 stages.

endmenu # RX FIFO 0

