		generator source clock divided by 1, 2, 4 or 8 for values 1 to 4.

config RZV2H_SCI_I2C1_BITRATE_MODULATION
	bool "SCI1 bit rate modulation"
	default y
	---help---
		Use the MDDR bit rate modulation function to reduce the error
		between the requested and the actual bit rate.

config RZV2H_SCI_I2C1_IRQ_PRIORITY
	int "SCI1 I2C interrupt priority"
	range 0 15
	default 12

endif # RZV2H_SCI_I2C1

config RZV2H_SCI_I2C2
	bool "SCI I2C 2"
	default n
