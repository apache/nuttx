config RZV2H_UBOOT_IMAGE
	bool "Generate split CR8_0 U-Boot images"
	default n
	depends on RZV2H_CORTEXR8_0
	---help---
		Link the low-vector table at its ITCM run address, with its load copy
		at the start of RCPU SRAM, and generate the raw image nuttx_uboot.bin
		(the table's load copy, code and data) after linking.  U-Boot loads
		it at CONFIG_RAM_START.  CR8_0 takes its reset vector from ITCM, so
		U-Boot also writes a two-word trampoline into ITCM through its AXI
		alias before releasing CR8_0 from reset:

		  mw.l 0x12040000 0xe51ff004   (ldr pc, [pc, #-4])
		  mw.l 0x12040004 0x08180000   (start of nuttx_uboot.bin)

		NuttX replaces the trampoline with the full vector table at boot.

		Leave this disabled for debugger loading.  In that layout the vector
		table is linked into SRAM and copied to ITCM by the NuttX startup
		code after the debugger enters the firmware at __start.

menuconfig RZV2H_CANFD
	bool "CANFD support"
	default n
	---help---
		Enable Renesas CAN-FD driver for RZ/V2H. This driver
		supports CAN FD (Flexible Data-rate) with up to 6 channels.

if RZV2H_CANFD

choice
	prompt "CAN character driver or SocketCAN support"
	default RZV2H_CANFD_CHARDEV
	---help---
		How applications use the enabled CAN-FD channels.

config RZV2H_CANFD_CHARDEV
	bool "Character device (/dev/canX)"
	select CAN
	select ARCH_HAVE_CAN_ERRORS
	---help---
		Channel n is the character device /dev/can<n> of the NuttX
		CAN driver (CONFIG_CAN).

config RZV2H_CANFD_SOCKET
	bool "SocketCAN (canX network interface)"
	depends on NET_CAN
	select NET_CAN_HAVE_CANFD
	select NET_CAN_HAVE_ERRORS
	select NET_CAN_HAVE_TX_DEADLINE
	---help---
		Channel n is the SocketCAN network interface can<n>
		(CONFIG_NET_CAN). Bring it up with "ifup can<n>".

endchoice # CAN character driver or SocketCAN support

if RZV2H_CANFD_SOCKET

config RZV2H_CANFD_SOCK_RX_DEPTH
	int "SocketCAN RX queue depth"
	default 16
	range 1 255
	---help---
		Number of received frames and error frames one channel holds
		until the network stack reads them. When the queue is full,
		new frames are dropped and an RX overflow error frame is
		sent.

config RZV2H_CANFD_SOCK_LOOPBACK
	bool "SocketCAN loopback mode at ifup"
	default n
	---help---
		Enter the mode selected in "Loopback Mode" when the
		interface is brought up.

endif # RZV2H_CANFD_SOCKET

# =========================================================================
# Global Settings
# =========================================================================

menu "Global"

menu "Global Error Interrupt"
	depends on RZV2H_CANFD

menu "Sources"

config RZV2H_CANFD_GLOBAL_ERR_DEIE
	bool "DLC Check Error Interrupt"
	default n
	---help---
		Enable interrupt on DLC check error.

config RZV2H_CANFD_GLOBAL_ERR_MEIE
	bool "Message Lost Error Interrupt"
	default n
	---help---
		Enable interrupt on message lost error.

config RZV2H_CANFD_GLOBAL_ERR_CMPOFIE
	bool "FD Payload Overflow Error Interrupt"
	default n
	---help---
		Enable interrupt on FD payload overflow error.

endmenu # Sources

config RZV2H_CANFD_GLOBAL_ERR_CH
	int "Callback Channel"
	default 0
	range 0 5
	---help---
		Channel that gets the DLC, FD payload overflow and ECC error
		reports. While it is not open, they are not reported.

config RZV2H_CANFD_GLOBAL_ERR_PRIORITY
	int "Global Error Interrupt Priority"
	default 12
	range 0 15
	---help---
		Priority for the global error interrupt. This interrupt is
		fired for each of the error sources selected above.

endmenu # Global Error Interrupt

