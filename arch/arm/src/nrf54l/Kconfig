comment "nRF54L Configuration Options"

# nRF54L Families

choice
	prompt "nRF54L Chip Selection"
	default ARCH_CHIP_NRF54L15
	depends on ARCH_CHIP_NRF54L

config ARCH_CHIP_NRF54L15
	bool "nRF54L15"

config ARCH_CHIP_NRF54LM20A
	bool "nRF54LM20A"

config ARCH_CHIP_NRF54LM20B
	bool "nRF54LM20B"

endchoice # nRF54L Chip Selection

# Peripheral Selection

config NRF54L_I2C_MASTER
	bool
	default n
	select I2C

config NRF54L_SPI_MASTER
	bool
	default n
	select SPI
	select ARCH_HAVE_SPI_BITORDER

config NRF54L_UART
	bool
	default n

config NRF54L_TIMER
	bool
	default n

config NRF54L_PWM
	bool
	default n

menu "nRF54L Peripheral Selection"

config NRF54L_GPIOTE
	bool "GPIOTE (GPIO interrupts)"
	default n

config NRF54L_I2C0_MASTER
	bool "I2C0 Master (TWIM20)"
	default n
	depends on !NRF54L_UART0
	select NRF54L_I2C_MASTER

config NRF54L_I2C1_MASTER
	bool "I2C1 Master (TWIM21)"
	default n
	depends on !NRF54L_UART1
	select NRF54L_I2C_MASTER

config NRF54L_I2C2_MASTER
	bool "I2C2 Master (TWIM22)"
	default n
	depends on !NRF54L_UART2
	select NRF54L_I2C_MASTER

config NRF54L_I2C3_MASTER
	bool "I2C3 Master (TWIM30)"
	default n
	depends on !NRF54L_UART3
	select NRF54L_I2C_MASTER

config NRF54L_I2C4_MASTER
	bool "I2C4 Master (TWIM23)"
	default n
	depends on !ARCH_CHIP_NRF54L15 && !NRF54L_UART5
	select NRF54L_I2C_MASTER

config NRF54L_I2C5_MASTER
	bool "I2C5 Master (TWIM24)"
	default n
	depends on !ARCH_CHIP_NRF54L15 && !NRF54L_UART6
	select NRF54L_I2C_MASTER

config NRF54L_SPI0_MASTER
	bool "SPI0 Master (SPIM20)"
	default n
	depends on !NRF54L_UART0 && !NRF54L_I2C0_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_SPI1_MASTER
	bool "SPI1 Master (SPIM21)"
	default n
	depends on !NRF54L_UART1 && !NRF54L_I2C1_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_SPI2_MASTER
	bool "SPI2 Master (SPIM22)"
	default n
	depends on !NRF54L_UART2 && !NRF54L_I2C2_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_SPI3_MASTER
	bool "SPI3 Master (SPIM30)"
	default n
	depends on !NRF54L_UART3 && !NRF54L_I2C3_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_SPI4_MASTER
	bool "SPI4 Master (SPIM00)"
	default n
	depends on !NRF54L_UART4
	select NRF54L_SPI_MASTER

config NRF54L_SPI5_MASTER
	bool "SPI5 Master (SPIM23)"
	default n
	depends on !ARCH_CHIP_NRF54L15 && !NRF54L_UART5 && !NRF54L_I2C4_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_SPI6_MASTER
	bool "SPI6 Master (SPIM24)"
	default n
	depends on !ARCH_CHIP_NRF54L15 && !NRF54L_UART6 && !NRF54L_I2C5_MASTER
	select NRF54L_SPI_MASTER

config NRF54L_UART0
	bool "UART0"
	default n
	select UART0_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART0 (UARTE20). The board must provide
		BOARD_UART0_TX_PIN and BOARD_UART0_RX_PIN.

config NRF54L_UART1
	bool "UART1"
	default n
	select UART1_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART1 (UARTE21). The board must provide
		BOARD_UART1_TX_PIN and BOARD_UART1_RX_PIN.

config NRF54L_UART2
	bool "UART2"
	default n
	select UART2_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART2 (UARTE22). The board must provide
		BOARD_UART2_TX_PIN and BOARD_UART2_RX_PIN.

config NRF54L_UART3
	bool "UART3"
	default n
	select UART3_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART3 (UARTE30). The board must provide
		BOARD_UART3_TX_PIN and BOARD_UART3_RX_PIN.

config NRF54L_UART4
	bool "UART4"
	default n
	select UART4_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART4 (UARTE00). The board must provide
		BOARD_UART4_TX_PIN and BOARD_UART4_RX_PIN.

config NRF54L_UART5
	bool "UART5"
	default n
	depends on ARCH_CHIP_NRF54LM20A || ARCH_CHIP_NRF54LM20B
	select UART5_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART5 (UARTE23). The board must provide
		BOARD_UART5_TX_PIN and BOARD_UART5_RX_PIN.

config NRF54L_UART6
	bool "UART6"
	default n
	depends on ARCH_CHIP_NRF54LM20A || ARCH_CHIP_NRF54LM20B
	select UART6_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART6 (UARTE24). The board must provide
		BOARD_UART6_TX_PIN and BOARD_UART6_RX_PIN.

config NRF54L_TIMER0
	bool "TIMER0 (TIMER20)"
	select NRF54L_TIMER
	depends on !NRF54L_SOFTDEVICE_CONTROLLER
	default n

config NRF54L_TIMER1
	bool "TIMER1 (TIMER21)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER2
	bool "TIMER2 (TIMER22)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER3
	bool "TIMER3 (TIMER23)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER4
	bool "TIMER4 (TIMER24)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER5
	bool "TIMER5 (TIMER00)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER6
	bool "TIMER6 (TIMER10)"
	select NRF54L_TIMER
	depends on !NRF54L_SOFTDEVICE_CONTROLLER
	default n

config NRF54L_PWM0
	bool "PWM0 (PWM20)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_PWM1
	bool "PWM1 (PWM21)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_PWM2
	bool "PWM2 (PWM22)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_SAADC
	bool "SAADC"
	default n

config NRF54L_GRTC
	bool "GRTC"
	default n

config NRF54L_USBDEV
	bool "USB Device"
	default n
	depends on ARCH_CHIP_NRF54LM20A || ARCH_CHIP_NRF54LM20B
	select USBDEV
	select SCHED_LPWORK

endmenu # nRF54L Peripheral Selection

config NRF54L_USE_LFCLK
	bool "Enable LFCLK"
	default n
	---help---
		Enable low-frequency clock.

if NRF54L_USE_LFCLK

choice
	prompt "LFCLK source"
	default NRF54L_LFCLK_XTAL

config NRF54L_LFCLK_XTAL
	bool "External 32.768Khz crystal"

config NRF54L_LFCLK_RC
	bool "Internal RC oscillator"

config NRF54L_LFCLK_SYNTH
	bool "Synthesized from HFCLK"

endchoice # LFCLK source

endif # NRF54L_USE_LFCLK

menu "System Timer"

choice
	prompt "System Timer Source"
	default NRF54L_SYSTIMER_SYSTICK

config NRF54L_SYSTIMER_SYSTICK
	bool "SysTick"
	select TIMER
	select TIMER_ARCH
	select ARMV8M_SYSTICK

config NRF54L_SYSTIMER_GRTC
	bool "GRTC"
	select NRF54L_GRTC
	select ARCH_HAVE_TICKLESS
	select SCHED_TICKLESS
	select SCHED_TICKLESS_ALARM
	select NRF54L_USE_LFCLK
	---help---
		Use GRTC timer in tickless mode.

endchoice # System Timer Source

endmenu # System Timer

config NRF54L_PROGMEM
	bool "RRAM program memory"
	default n
	depends on !NRF54L_SOFTDEVICE_CONTROLLER
	select ARCH_HAVE_PROGMEM
	---help---
		Enable the program memory interfaces in nuttx/progmem.h.
		RRAM erase blocks are emulated as 4 KiB regions filled with 0xff.

config NRF54L_DEBUG_ACCESS
	bool "Keep firmware-controlled debug access open"
	default y
	---help---
		Open unlocked TAMPC debug signals for SWD/RTT development.
		Signals locked by an earlier boot stage are left unchanged.

menu "GPIO Interrupt Configuration"

config NRF54L_PER_PIN_INTERRUPTS
	bool "Per-pin interrupt callbacks"
	default n
	depends on NRF54L_GPIOTE
	---help---
		Dispatch PORT events to separate callbacks for each pin.

endmenu # GPIO Interrupt Configuration

menu "PWM configuration"

if NRF54L_PWM

config NRF54L_PWM_MULTICHAN
	bool "PWM Multiple Output Channels"
	default n

if NRF54L_PWM_MULTICHAN

if NRF54L_PWM0

config NRF54L_PWM0_CH0
	bool "PWM0 Channel 0 Output"
	default n
	---help---
		Enables channel 0 output.

