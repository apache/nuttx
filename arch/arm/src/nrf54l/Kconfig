endif # NRF54L_PWM_MULTICHAN

if !NRF54L_PWM_MULTICHAN

config NRF54L_PWM0_CHANNEL
	int "PWM0 Output Channel"
	depends on NRF54L_PWM0
	default 0
	range 0 3

config NRF54L_PWM1_CHANNEL
	int "PWM1 Output Channel"
	depends on NRF54L_PWM1
	default 0
	range 0 3

config NRF54L_PWM2_CHANNEL
	int "PWM2 Output Channel"
	depends on NRF54L_PWM2
	default 0
