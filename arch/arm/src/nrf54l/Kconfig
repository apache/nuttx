	bool "PWM2 Channel 0 Output"
	default n
	---help---
		Enables channel 0 output.

config NRF54L_PWM2_CH1
	bool "PWM2 Channel 1 Output"
	default n
	---help---
		Enables channel 1 output.

config NRF54L_PWM2_CH2
	bool "PWM2 Channel 2 Output"
	default n
	---help---
		Enables channel 2 output.

