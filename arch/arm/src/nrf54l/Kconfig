endmenu # PWM configuration

menu "SAADC Configuration"

if NRF54L_SAADC

choice
	prompt "SAADC trigger selection"
	default NRF54L_SAADC_TASK

config NRF54L_SAADC_TASK
	bool "SAADC Task trigger"

config NRF54L_SAADC_TIMER
	bool "SAADC Timer trigger"
	---help---
		Use the local timer for a single channel. Each ANIOC_TRIGGER
		collects one result and then stops the timer.

endchoice # SAADC trigger selection

if NRF54L_SAADC_TIMER

config NRF54L_SAADC_TIMER_CC
	int "SAADC Timer CC"
	default 192
	range 8 2047
	---help---
		Sample rate is 16 MHz / CC. The period must accommodate the
		channel acquisition time plus 2 us conversion time, multiplied
		by the oversampling factor when burst is enabled.

endif # NRF54L_SAADC_TIMER

config NRF54L_SAADC_OVERSAMPLE
	int "SAADC oversample"
	default 0
	range 0 8
	---help---
		Zero disables oversampling; values 1 through 8 select 2 through
		256 samples per result. Scanning multiple channels requires
		burst mode on every channel when oversampling is enabled.

config NRF54L_SAADC_RESOLUTION
	int "SAADC resolution"
	default 0
	range 0 3
	---help---
		SAADC resolution: 0 - 8 bits, 1 - 10 bits, 2 - 12 bits, 3 - 14 bits.

config NRF54L_SAADC_CHANNELS
	int "SAADC channels"
	default 8
	range 1 8

config NRF54L_SAADC_LIMITS
	bool "SAADC limits enable"
	default n
	---help---
		Configure the high and low limit events for each channel.

endif # NRF54L_SAADC

endmenu # SAADC Configuration

menu "SPI Configuration"

if NRF54L_SPI_MASTER

config NRF54L_SPI_MASTER_INTERRUPTS
	bool "SPI Master interrupts support"
	default n

endif # NRF54L_SPI_MASTER

endmenu # SPI Configuration

menu "I2C Master Configuration"

if NRF54L_I2C_MASTER

config NRF54L_I2C_MASTER_DISABLE_NOSTART
	bool "Disable the I2C Master NOSTART flag support"
	default n
	---help---
		Disable combining two write messages into one DMA buffer.

config NRF54L_I2C_MASTER_COPY_BUF_SIZE
	int "Static buffer size for NOSTART flag support"
	depends on !NRF54L_I2C_MASTER_DISABLE_NOSTART
	default 4
	range 1 65535
	---help---
		Size of the per-bus buffer used to combine two continued write
		messages. Their combined length must fit in this buffer; larger
		transfers return E2BIG before starting the transaction.

config NRF54L_I2C_MASTER_TIMEOUT
	int "I2C transfer timeout (milliseconds)"
	default 1000
	range 1 60000
	---help---
		Send STOP if the transfer does not finish within this interval.
		Completion still waits for STOPPED before releasing DMA buffers;
		a device holding the bus can delay this cleanup.

endif # NRF54L_I2C_MASTER

endmenu # I2C Master Configuration

menuconfig NRF54L_SOFTDEVICE_CONTROLLER
	bool "SoftDevice Controller"
	depends on ALLOW_BSDNORDIC_COMPONENTS
	depends on NET_BLUETOOTH || UART_BTH4
	select ARCH_RAMVECTORS
	select ARCH_IRQPRIO
	select ARCH_HIPRI_INTERRUPT
	select CRYPTO
	select CRYPTO_RANDOM_POOL
	select SCHED_LPWORK
	select NRF54L_GRTC
	select NRF54L_USE_LFCLK
	---help---
		Enable Nordic's Bluetooth LE SoftDevice Controller and MPSL.
		MPSL reserves GRTC channels 7-11, TIMER10, TIMER20, ECB00,
		RADIO, CLOCK and TEMP. SDC also reserves AAR00, CCM00 and
		RRAMC. Their DPPI and PPIB channels must not be used by the
		application. HFXO remains running at 32 MHz.
		Use an interrupt stack and allow sufficient stack space for
		controller initialization and the low-priority work queue.

if NRF54L_SOFTDEVICE_CONTROLLER

config NRF54L_SDC_CLOCK_ACCURACY
	int "Clock Accuracy [PPM]"
	default 50
	range 20 500
	---help---
		Accuracy of the board's HFXO, which supplies synthesized LFCLK.

config NRF54L_SDC_PERIPHERAL_COUNT
	int "Number of peripheral connections"
	default 1
	range 0 20

config NRF54L_SDC_MAX_COUNT
	int "Maximum number of connections"
	default 2
	range 1 20
	depends on !NET_BLUETOOTH
	---help---
		The remaining connections are central roles. With the native
		Bluetooth host, BLUETOOTH_MAX_CONN provides this total instead.

config NRF54L_SDC_ADVERTISING
	bool "Support advertising"
	default y

config NRF54L_SDC_SCANNING
	bool "Support scanning"
	default y

if NRF54L_SDC_SCANNING

config NRF54L_SDC_SCAN_BUFFER_COUNT
	int "Scanning buffer count"
	default 3
	range 2 255

endif # NRF54L_SDC_SCANNING

config NRF54L_SDC_LE_2M_PHY
	bool "Support LE 2M PHY"
	default y

config NRF54L_SDC_LE_CODED_PHY
	bool "Support LE Coded PHY"
	default y

config NRF54L_SDC_DLE
	bool "Support Data Length Extension (DLE)"
	default y

config NRF54L_SDC_FICR_STATIC_ADDR
	bool "Configure factory generated static random address"
	default y

config NRF54L_SDC_PUB_ADDR
	hex "Configure Bluetooth public address"
	default 0x000000000000
	---help---
		Public address, most significant byte first.
		For example, 0x010203040506 configures 06:05:04:03:02:01.
		Zero leaves the controller public address unset. The native
		NuttX Bluetooth host requires a public address; hosts using a
		static random address configure it through HCI instead.

endif # NRF54L_SOFTDEVICE_CONTROLLER
