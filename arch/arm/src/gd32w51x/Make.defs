include armv8-m/Make.defs

CHIP_CSRCS  = gd32w51x_start.c gd32w51x_clockconfig.c gd32w51x_irq.c
CHIP_CSRCS += gd32w51x_timerisr.c gd32w51x_lowputc.c gd32w51x_serial.c
CHIP_CSRCS += gd32w51x_tzinit.c gd32w51x_idle.c

ifeq ($(CONFIG_PM),y)
CHIP_CSRCS += gd32w51x_pm.c
endif

ifeq ($(CONFIG_RTC),y)
CHIP_CSRCS += gd32w51x_rtc.c
endif

ifeq ($(CONFIG_GD32W51X_DMA),y)
CHIP_CSRCS += gd32w51x_dma.c
endif

CHIP_CSRCS += gd32w51x_gpio.c

ifeq ($(CONFIG_GD32W51X_GPIO_IRQ),y)
CHIP_CSRCS += gd32w51x_exti.c
endif

ifeq ($(CONFIG_GD32W51X_SPI),y)
CHIP_CSRCS += gd32w51x_spi.c
endif

ifeq ($(CONFIG_GD32W51X_QSPI),y)
CHIP_CSRCS += gd32w51x_qspi.c
endif

ifeq ($(CONFIG_GD32W51X_TSI),y)
CHIP_CSRCS += gd32w51x_tsi.c
endif

ifeq ($(CONFIG_GD32W51X_I2C),y)
CHIP_CSRCS += gd32w51x_i2c.c
endif

ifeq ($(CONFIG_GD32W51X_ADC),y)
CHIP_CSRCS += gd32w51x_adc.c
endif

ifeq ($(CONFIG_GD32W51X_PWM),y)
CHIP_CSRCS += gd32w51x_pwm.c
endif

ifeq ($(CONFIG_GD32W51X_CAPTURE),y)
CHIP_CSRCS += gd32w51x_capture.c
endif

ifeq ($(CONFIG_GD32W51X_FWDGT),y)
CHIP_CSRCS += gd32w51x_fwdgt.c
endif

ifeq ($(CONFIG_GD32W51X_WWDGT),y)
CHIP_CSRCS += gd32w51x_wwdgt.c
endif

ifeq ($(CONFIG_GD32W51X_PROGMEM),y)
CHIP_CSRCS += gd32w51x_progmem.c
endif

ifeq ($(CONFIG_GD32W51X_RNG),y)
CHIP_CSRCS += gd32w51x_rng.c
endif

ifeq ($(CONFIG_GD32W51X_CRC),y)
CHIP_CSRCS += gd32w51x_crc.c
endif
