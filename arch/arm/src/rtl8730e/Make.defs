ifeq ($(CONFIG_ARCH_ARMV7A),y)
include armv7-a/Make.defs
endif

ifeq ($(CONFIG_ARCH_ARMV7R),y)
include armv7-r/Make.defs
endif

# IC-agnostic Ameba glue (os_wrapper backend, netdev, flash MTD, ...) is
# shared from arch/arm/src/common/ameba/.  Put it on VPATH + the include
# path once, with a relative VPATH entry (no leading ":" and no duplicate
# absolute entries): arch/arm/src/Makefile expands VPATH into mkdeps
# --dep-path args via "$(subst :, ,$(VPATH))", so a leading ":" injects an
# empty dep-path that breaks parallel .ddc dependency generation.  This
# matches the rtl8721dx pattern.

AMEBA_COMMON_SRC = $(TOPDIR)$(DELIM)arch$(DELIM)arm$(DELIM)src$(DELIM)common$(DELIM)ameba
VPATH    += common$(DELIM)ameba
INCLUDES += ${INCDIR_PREFIX}$(AMEBA_COMMON_SRC)

# rtl8730e-specific C source files
CHIP_CSRCS  = rtl8730e_boot.c rtl8730e_serial.c rtl8730e_irq.c rtl8730e_timer.c

ifeq ($(CONFIG_ARCH_ARMV7A),y)
CHIP_CSRCS += rtl8730e_pgalloc.c rtl8730e_memorymap.c
endif

ifeq ($(CONFIG_SMP),y)
  CHIP_CSRCS += rtl8730e_cpuboot.c
endif

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += rtl8730e_idle.c
endif

ifeq ($(CONFIG_BUILD_PROTECTED),y)
  CHIP_CSRCS += rtl8730e_userspace.c rtl8730e_allocateheap.c
endif

AMEBA_AP_SOC_LIB = $(TOPDIR)/arch/arm/src/common/ameba/ameba-rtos/component/soc/amebasmart/project/project_ap/lib/soc

# lib_rom.a provides ROM stubs (GPIO, UART, flash, Pinmux, etc.).
# rtl8730e_flash_stubs.c supplies the RAM-side symbols that lib_rom.a objects
# expect (DiagPrintfNano, irq_enable, Pinmux_Config, etc.).  Compile them once
# whenever any driver needing ROM is enabled.
ifneq ($(filter y,$(CONFIG_AMEBA_GPIO) $(CONFIG_RTL8730E_FLASH_FS)),)
CHIP_CSRCS += rtl8730e_flash_stubs.c
EXTRA_LIBS += $(AMEBA_AP_SOC_LIB)$(DELIM)lib_rom.a
endif

ifeq ($(CONFIG_AMEBA_GPIO),y)
CHIP_CSRCS += ameba_gpio.c
endif

# WiFi (WHC host, CA32 side).
ifeq ($(CONFIG_RTL8730E_WIFI),y)
CHIP_CSRCS += rtl8730e_wifi_init.c
CHIP_CSRCS += rtl8730e_wifi_stubs.c
CHIP_CSRCS += ameba_os_wrap.c
CHIP_CSRCS += ameba_wlan.c

AMEBA_PREBUILT      = $(BOARD_DIR)$(DELIM)prebuilt
AMEBA_PREBUILT_LIBS = $(AMEBA_PREBUILT)$(DELIM)libs

AMEBA_AP_LIB = $(TOPDIR)/arch/arm/src/common/ameba/ameba-rtos/component/soc/amebasmart/project/project_ap/lib/application

EXTRA_LIBS += $(AMEBA_AP_LIB)$(DELIM)lib_wifi_whc_ap.a
EXTRA_LIBS += $(AMEBA_AP_LIB)$(DELIM)lib_wifi_rtk_app.a
EXTRA_LIBS += $(AMEBA_AP_LIB)$(DELIM)lib_wifi_com_sec.a
EXTRA_LIBS += $(AMEBA_AP_LIB)$(DELIM)lib_wpa_lite.a
EXTRA_LIBS += $(AMEBA_PREBUILT_LIBS)$(DELIM)libameba_wifi.a
endif

# On-chip SPI NOR flash MTD (littlefs data partition).
ifeq ($(CONFIG_RTL8730E_FLASH_FS),y)

# ameba_flash_mtd.c lives in the common Ameba driver directory (already on
# VPATH + INCLUDES at the top of this file).
CHIP_CSRCS += ameba_flash_mtd.c

# Prebuilt staging area (within the board tree, gitignored).
AMEBA_PREBUILT      = $(BOARD_DIR)$(DELIM)prebuilt
AMEBA_PREBUILT_LIBS = $(AMEBA_PREBUILT)$(DELIM)libs

# fwlib archive built by PREBUILD from SDK source (FLASH_ReadStream/
# WriteStream/EraseXIP + IPC layer for the CA32 write-lock protocol).
EXTRA_LIBS += $(AMEBA_PREBUILT_LIBS)$(DELIM)libameba_fwlib.a

endif
