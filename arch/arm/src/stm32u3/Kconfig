if ARCH_CHIP_STM32U3

comment "STM32U3 Configuration Options"

config STM32_U3_PERIPHERALS
	bool
	default y
	select STM32_HAVE_DMA1
	select STM32_HAVE_FDCAN1
	select STM32_HAVE_FDCAN2
	select STM32_HAVE_IP_DMA_GPDMA
	select STM32_HAVE_IP_EXTI_M33M55_V1
	select STM32_HAVE_IP_FDCAN_MCAN_V1
	select STM32_HAVE_IP_GPIO_M33M55_V1
	select STM32_HAVE_IP_TIMERS_V3
	select STM32_HAVE_IP_DBGMCU_V5
	select STM32_HAVE_IP_LPTIM_V2
	select STM32_HAVE_IP_WDG_V3
	select STM32_HAVE_LPTIM1
	select STM32_HAVE_LPTIM2
	select STM32_HAVE_LPTIM3
	select STM32_HAVE_LPTIM4
	select STM32_HAVE_IP_USART_M33M55_V3
	select STM32_HAVE_SYSCFG
	select STM32_HAVE_USART1
	select STM32_HAVE_USART2
	select STM32_HAVE_USART3
	select STM32_HAVE_UART4
	select STM32_HAVE_UART5
	select STM32_HAVE_LPUART1
	select STM32_HAVE_IP_DAC_M33_V1
	select STM32_HAVE_DAC1

choice
	prompt "STM32U3 Chip Selection"
	default ARCH_CHIP_STM32U3C5ZI

config ARCH_CHIP_STM32U3C5ZI
	bool "STM32U3C5ZI"
	select STM32_STM32U3C5XX
	select STM32U3_IO_CONFIG_Z
	---help---
		STM32U3 Cortex-M33, 2048 KiB flash, 640 KiB SRAM, LQFP144.

endchoice

config STM32_STM32U3C5XX
	bool
	select ARCH_HAVE_FPU
	select STM32_HAVE_TIM1
	select STM32_HAVE_TIM2
	select STM32_HAVE_TIM3
	select STM32_HAVE_TIM4
	select STM32_HAVE_TIM6
	select STM32_HAVE_TIM7
	select STM32_HAVE_TIM8
	select STM32_HAVE_TIM12
	select STM32_HAVE_TIM15
	select STM32_HAVE_TIM16
	select STM32_HAVE_TIM17
	select STM32_HAVE_TIM2_32BITS

config STM32U3_IO_CONFIG_Z
	bool

endif # ARCH_CHIP_STM32U3
