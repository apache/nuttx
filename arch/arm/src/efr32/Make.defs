include armv8-m/Make.defs

CHIP_CSRCS  = efr32_start.c efr32_clockconfig.c efr32_irq.c
CHIP_CSRCS += efr32_timerisr.c efr32_lowputc.c efr32_gpio.c

ifeq ($(CONFIG_EFR32_GPIO_IRQ),y)
CHIP_CSRCS += efr32_gpioirq.c
endif

ifeq ($(CONFIG_EFR32_USART0),y)
CHIP_CSRCS += efr32_serial.c
endif
