include arm/Make.defs

# The vector table lives in the start-up file (its reset slot must be a
# relative branch) and the idle loop sleeps the core.

HEAD_ASRC  = pp502x_head.S

CMN_ASRCS := $(filter-out arm_vectortab.S,$(CMN_ASRCS))
CMN_CSRCS := $(filter-out arm_idle.c,$(CMN_CSRCS))

CHIP_CSRCS  = pp502x_allocateheap.c pp502x_cache.c pp502x_decodeirq.c pp502x_irq.c
CHIP_CSRCS += pp502x_lowsetup.c pp502x_serial.c

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += pp502x_timerisr.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += pp502x_idle.c
endif
