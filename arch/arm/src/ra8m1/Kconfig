config RA_GPT_TIMER
	bool "GPT timer (/dev/timerN)"
	default n
	select TIMER
	---help---
		Register enabled GPT channels as generic timers.  Each enabled
		channel uses one ICU slot (its overflow event).

if RA_GPT_TIMER

