include armv7-r/Make.defs

# RM57-specific C source files

CHIP_CSRCS  = rm57_boot.c rm57_clockconfig.c rm57_mpuinit.c rm57_gio.c
CHIP_CSRCS += rm57_irq.c rm57_lowputc.c rm57_serial.c rm57_esm.c

CHIP_ASRCS  = rm57_coreinit.S

# Configuration dependent C and assembly language files

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += rm57_timerisr.c
endif

# RM57 has no GIC - it uses the classic Hercules VIM interrupt controller

CMN_CSRCS := $(filter-out arm_gicv2.c arm_gicv2_dump.c, $(CMN_CSRCS))
