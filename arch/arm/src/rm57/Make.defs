include armv7-r/Make.defs

# RM57-specific C source files

CHIP_CSRCS  = rm57_boot.c rm57_clockconfig.c rm57_mpuinit.c rm57_gio.c
CHIP_CSRCS += rm57_gioirq.c
CHIP_CSRCS += rm57_irq.c rm57_lowputc.c rm57_serial.c rm57_esm.c
CHIP_CSRCS += rm57_iomm.c

ifeq ($(CONFIG_RM57_SELFTEST),y)
CHIP_CSRCS += rm57_selftest.c
ifeq ($(CONFIG_RM57_SELFTEST_PBIST_ROM),y)
CHIP_CSRCS += rm57_errata.c
endif
endif

CHIP_ASRCS  = rm57_coreinit.S

# Configuration dependent C and assembly language files

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += rm57_timerisr.c
endif

ifeq ($(CONFIG_RM57_DMA),y)
CHIP_CSRCS += rm57_dma.c
endif

ifeq ($(CONFIG_RM57_LIN),y)
CHIP_CSRCS += rm57_lin.c
endif

ifeq ($(CONFIG_RM57_MIBSPI),y)
CHIP_CSRCS += rm57_mibspi.c
endif

ifeq ($(CONFIG_RM57_I2C),y)
CHIP_CSRCS += rm57_i2c.c
endif

ifeq ($(CONFIG_RM57_ADC),y)
CHIP_CSRCS += rm57_adc.c
ifeq ($(CONFIG_RM57_ADC_TEMPSENSOR),y)
CHIP_CSRCS += rm57_adc_temp.c
endif
endif

ifeq ($(CONFIG_RM57_DCAN),y)
CHIP_CSRCS += rm57_dcan.c
ifeq ($(CONFIG_CAN),y)
CHIP_CSRCS += rm57_dcan_chardev.c
endif
ifeq ($(CONFIG_NET_CAN),y)
CHIP_CSRCS += rm57_dcan_sock.c
endif
endif

ifeq ($(CONFIG_RM57_EMAC),y)
CHIP_CSRCS += rm57_ethernet.c rm57_mdio.c
endif

ifeq ($(CONFIG_NET),y)
ifneq ($(CONFIG_NETDEV_LATEINIT),y)
CHIP_CSRCS += rm57_netinitialize.c
endif
endif

# RM57 has no GIC - it uses the classic Hercules VIM interrupt controller

CMN_CSRCS := $(filter-out arm_gicv2.c arm_gicv2_dump.c, $(CMN_CSRCS))
