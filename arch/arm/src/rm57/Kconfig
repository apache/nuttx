		rather than the high-to-low transition.

# ADC2's DMA request lines are alternate functions shared with MibSPI1 and
# MibSPI3 (lines 14, 16 and 17), so selecting them needs the system module's
# DMA request source mux to be reprogrammed.  That is not implemented, and
# ADC2 therefore has no DMA option.

endif # RM57_ADC2_G1

menuconfig RM57_ADC2_G2
	bool "ADC2 Group2"
	default n
	---help---
		Expose the ADC2 Group2 as its own /dev/adcN character device.
		The group has an independent channel selection, trigger source,
		sampling window, results FIFO and interrupt (VIM channel
		RM57_REQ_ADC2GROUP2).

if RM57_ADC2_G2

config RM57_ADC2_G2_CHANMASK
	hex "ADC2 Group2 channel mask"
	default 0x1
	---help---
		Bit mask of the analog inputs converted by this group; bit n
		selects AD2IN[n].  In the default sequential mode the selected
		channels are converted in ascending channel number.

config RM57_ADC2_G2_BUFS
	int "ADC2 Group2 result buffers"
	default 16
	range 0 64
	---help---
		Words of the module's 64-word results RAM reserved for this
		group.  The Event group and Group1 counts must be even because
		ADBNDCR allocates the memory in pairs, and the three groups of
		one module must not ask for more than 64 words in total.  Both
		rules are checked at compile time.

config RM57_ADC2_G2_THRESHOLD
	int "ADC2 Group2 interrupt threshold"
	default 8
	range 1 511
	---help---
		How many conversion results accumulate before the group raises
		its threshold interrupt.  Larger values reduce the interrupt
		rate but need a correspondingly larger result buffer count.

config RM57_ADC2_G2_ACQ
	int "ADC2 Group2 acquisition time"
	default 8
	range 1 4095
	---help---
		Sampling window in ADCLK cycles minus two: SW = ACQ + 2, and the
		hardware requires SW >= 3.  The input impedance sets the real
		minimum - see the sample and hold timings in SPNS215.  When both
		modules convert a shared channel their windows must either match
		exactly or not overlap at all (TRM section 22.1).

config RM57_ADC2_G2_CONTINUOUS
	bool "ADC2 Group2 continuous conversion"
	default n
	---help---
		Convert the selected channels continuously instead of once per
		trigger.  Continuous groups report results through the threshold
		interrupt; single-shot groups use the conversion end interrupt.

config RM57_ADC2_G2_FREEZE
	bool "ADC2 Group2 freeze enable"
	default n
	---help---
		Allow this group's conversion sequence to be suspended while
		another group of the same module is serviced, resuming from
		where it stopped afterwards.

config RM57_ADC2_G2_OVRWRITE
	bool "ADC2 Group2 overwrite on overrun"
	default n
	---help---
		Let the ADC overwrite the oldest results when this group's
		memory fills up.  Without it the group stalls until the
		application has read the memory out.

config RM57_ADC2_G2_HWTRIG
	bool "ADC2 Group2 hardware triggered"
	default n
	---help---
		Start conversions from a hardware event rather than from a write
		to the channel select register.

config RM57_ADC2_G2_TRIGSRC
	int "ADC2 Group2 trigger source"
	default 0
	range 0 7
	depends on RM57_ADC2_G2_HWTRIG
	---help---
		Hardware trigger source: 0 = AD2EVT pin, 1 = N2HET1[8],
		2 = N2HET1[10], 3 = RTI compare 0, 4 = N2HET1[12],
		5 = N2HET1[14], 6 = GIOB[0], 7 = GIOB[1].  A second set of
		sources is reachable through the ALT_ADC_TRIGGER pin mux
		control; see SPNS215.

config RM57_ADC2_G2_RISING
	bool "ADC2 Group2 trigger on rising edge"
	default y
	depends on RM57_ADC2_G2_HWTRIG
	---help---
		Trigger on the low-to-high transition of the selected source
		rather than the high-to-low transition.

# ADC2's DMA request lines are alternate functions shared with MibSPI1 and
# MibSPI3 (lines 14, 16 and 17), so selecting them needs the system module's
# DMA request source mux to be reprogrammed.  That is not implemented, and
# ADC2 therefore has no DMA option.

endif # RM57_ADC2_G2
endif # RM57_ADC2

if RM57_ADC

config RM57_ADC_CALIBRATE
	bool "Calibrate the ADC at initialization"
	default y
	---help---
		Run the offset error calibration sequence when the first group
		of a module is registered.  Four internal reference voltages are
		converted and the deviation of their average from mid scale is
		loaded into ADCALR, which the hardware then adds to every
		conversion result (TRM SPNU562A section 22.2.6.1).

config RM57_ADC_MAGCOMP
	bool "Magnitude compare interrupts"
	default n
	---help---
		Build support for the three hardware magnitude comparators of
		each module, which interrupt when a monitored channel's result
		crosses a threshold.  This also backs the generic
		ANIOC_WDOG_UPPER and ANIOC_WDOG_LOWER commands, which claim
		comparators 0 and 1 of the owning module - so two groups of
		one module cannot both use the generic watchdog without
		overwriting each other.

		The comparators have their own VIM channel, separate from the
		conversion group interrupts, and the driver attaches a handler
		to it.  There is no notification path for an analog watchdog
		in the NuttX ADC upper half, though, so a crossing is
		acknowledged and counted rather than reported to the
		application.

config RM57_ADC_ENHANCED_CHSEL
	bool "Enhanced channel selection mode"
	default n
	depends on RM57_ADC1
	---help---
		Build support for the look-up table based conversion order,
		which converts channels in an arbitrary user-defined sequence
		rather than in ascending channel number.  Only ADC1 implements
		this mode (TRM SPNU562A section 22.2.2.2).

config RM57_ADC_PARITY
	bool "Results RAM parity checking"
	default y
	---help---
		Enable the parity check on the conversion results RAM.  A parity
		error is reported to the Error Signalling Module and the failing
		address is latched in ADPARADDR.  The RAM is auto-initialized
		before the check is switched on so untouched buffers cannot
		report spurious errors.

config RM57_ADC_TEMPSENSOR
	bool "On-chip temperature sensors"
	default n
	---help---
		Three on-die temperature sensors, each multiplexed onto one ADC
		channel: sensor 1 on ADC1 channel 31, sensors 2 and 3 on ADC2
		channels 31 and 30 (TRM SPNU562A section 6.5.13).  The driver
		releases them from power down, routes them onto their channels,
		and applies the factory calibration recorded in TI OTP so
		readings come out in real degrees Celsius.

if RM57_ADC_TEMPSENSOR

config RM57_ADC_TEMP1
	bool "Temperature sensor 1 (ADC1 channel 31)"
	default y
	depends on RM57_ADC1
	---help---
		Sensor 1 shares its channel with the AD1IN[31] ball, so
		enabling it makes that ball unavailable as an analog input.

config RM57_ADC_TEMP2
	bool "Temperature sensor 2 (ADC2 channel 31)"
	default y
	depends on RM57_ADC2

config RM57_ADC_TEMP3
	bool "Temperature sensor 3 (ADC2 channel 30)"
	default y
	depends on RM57_ADC2

config RM57_ADC_TEMP_UORB
	bool "Publish as UORB sensor nodes"
	default n
	select SENSORS
	---help---
		Register each enabled sensor with the UORB sensor framework as
		/dev/uorb/sensor_tempN, readable with the sensortest
		application.  This pulls in the whole sensor upper half, so it
		is worth having only on a board that speaks UORB already.

		Without it each sensor is a plain character device instead, and
		one read() returns a whole struct rm57_adc_temp_s.  Either way
		the sensors also stay reachable through the ANIOC_RM57_GET_TEMP
		ioctl on any /dev/adcN.

config RM57_ADC_TEMP_PATH
	string "Temperature device path prefix"
	default "/dev/temp"
	depends on !RM57_ADC_TEMP_UORB
	---help---
		Prefix of the character device registered for each sensor; the
		device number is appended, giving /dev/temp0 and upwards with
		the default.

config RM57_ADC_TEMP_DEVNO
	int "First device number"
	default 0
	range 0 32
	---help---
		Device number given to the first enabled sensor; the others
		follow in order.  Sensors of the same type must not share a
		device number, so shift this if something else on the board
		already registers a temperature sensor.

endif # RM57_ADC_TEMPSENSOR

config RM57_ADC_DMA_MAXSAMPLES
	int "Maximum DMA samples per callback"
	default 32
	range 1 256
	depends on RM57_ADC_HAVE_DMA
	---help---
		Upper bound on any group's DMA samples per transfer.  It sizes
		the scratch arrays the DMA callback uses to hand a batch to the
		upper half, so keep it as small as the configuration allows.

endif # RM57_ADC

menuconfig RM57_EMAC
	bool "Ethernet MAC (EMAC/MDIO)"
	default n
	select NETDEVICES
	select ARCH_HAVE_PHY
	select ARCH_HAVE_NETDEV_STATISTICS
	depends on ARCH_CHIP_RM57L843
	---help---
		TI CPSW-lite 10/100 Ethernet MAC, EMAC Control module and
		MDIO module.  There is exactly one EMAC on this device.

if RM57_EMAC

choice
	prompt "PHY interface mode"
	default RM57_EMAC_MII
	---help---
		The LAUNCHXL2-RM57L carries a DP83630 PHY wired for MII; the
		reset default IOMM selection is RMII, so MII must be
		explicitly selected here to match that board.

config RM57_EMAC_MII
	bool "MII"

config RM57_EMAC_RMII
	bool "RMII"
	---help---
		See the BOARD_VCLKA4_* comment in the board's board.h: this
		port does not independently verify the PLL2-derived 50MHz
		clock RMII requires and it should be measured on real
		hardware before relying on this mode.

endchoice # PHY interface mode

config RM57_EMAC_PHYADDR
	int "PHY address"
	default 1
	range 0 31

config RM57_EMAC_NTXDESC
	int "Number of TX descriptors"
	default 8
	range 2 128

config RM57_EMAC_NRXDESC
	int "Number of RX descriptors"
	default 16
	range 2 128

config RM57_EMAC_MDIO_FREQ
	int "MDIO clock (Hz)"
	default 1000000
	range 100000 2500000
	---help---
		SPNU562A Section 31.2.1: typical operation is 1MHz; the MDIO
		module is specified to run up to 2.5MHz.

config RM57_EMAC_AUTONEG
	bool "Autonegotiation"
	default y

config RM57_EMAC_ETHFD
	bool "Full duplex"
	default n
	depends on !RM57_EMAC_AUTONEG

config RM57_EMAC_ETH100MBPS
	bool "100 Mbps"
	default n
	depends on !RM57_EMAC_AUTONEG

config RM57_EMAC_PHY_INTERRUPT
	bool "PHY link-change interrupt (MDIO LINKINT0)"
	default y
	select ARCH_PHY_INTERRUPT
	---help---
		Enables SIOCMIINOTIFY / phy_notify support.  This driver
		always enables the underlying MDIO link-change interrupt for
		its own netdev_carrier_on/off tracking regardless of this
		setting; this option only gates whether a phy_notify
		subscriber can also attach to link events.

config RM57_EMAC_LOOPBACK
	bool "MAC internal loopback at ifup (self-test)"
	default n
	---help---
		Set MACCONTROL.LOOPBACK and skip the PHY link wait entirely,
		so the descriptor ring and interrupt path can be exercised
		standalone without a PHY or cable - the RM57_DCAN_LOOPBACK
		equivalent for Ethernet.

config RM57_EMAC_PROMISC
	bool "Promiscuous mode (RXMBPENABLE.RXCAFEN)"
	default n
	---help---
		Copy every frame the PHY delivers to RX channel 0, instead of
		only those matching the MAC address filter plus broadcast.
		Debug aid: if traffic is only received with this set, the
		problem is in the address filter (MACINDEX/MACADDRHI/MACADDRLO
		or RXUNICASTSET) rather than in the PHY, the descriptor ring or
		the interrupt path.  Leave it off in production - it hands the
		CPU every frame on the segment.

config RM57_EMAC_REGDEBUG
	bool "Register-level debug"
	default n
	depends on DEBUG_NET_INFO

endif # RM57_EMAC

endmenu # RM57 Peripheral Support

endif # ARCH_CHIP_RM57
