if RM57_DCAN

config RM57_DCAN_TXFIFO_DEPTH
	int "DCAN TX FIFO depth (mailboxes per instance)"
	default 8
	range 1 32
	---help---
		Number of message objects reserved for transmission, taken
		from the top of the 64-mailbox range so that RX filters keep
		the (higher priority) low mailbox numbers.

config RM57_DCAN_RXFIFO_DEPTH
	int "DCAN RX FIFO depth (mailboxes per filter)"
	default 8
	range 1 32
	---help---
		Number of message objects chained (EoB) into the receive FIFO
		of each acceptance filter, including the default catch-all
		filter installed when no user filter is active.

config RM57_DCAN_NFILTERS_MAX
	int "DCAN maximum concurrent acceptance filters"
	default 4
	range 1 8

config RM57_DCAN_IF3_NFRAMES
	int "DCAN IF3 DMA ring size (frames)"
	default 16
	range 2 64
	depends on RM57_DCAN1_RX_IF3DMA || RM57_DCAN2_RX_IF3DMA || \
		RM57_DCAN3_RX_IF3DMA || RM57_DCAN4_RX_IF3DMA

config RM57_DCAN_SECDED
	bool "DCAN message RAM SECDED (ECC)"
	default y
	---help---
		Keep the message RAM single-error-correction/double-error-
		detection logic enabled (CTL.PMD).  Disable only for
		bring-up debugging; parity events are reported through the
		CAN error reporting path when enabled.

config RM57_DCAN_LOOPBACK
	bool "DCAN internal loopback at setup (self-test)"
	default n
	---help---
		Enter internal loopback test mode (TEST.LBack) as part of
		controller setup so the driver can be exercised without a
		transceiver or bus.  Frames are looped back internally; the
		CAN_TX pin stays recessive.  Can also be controlled at
		runtime via CANIOC_SET_CONNMODES.

endif # RM57_DCAN

config RM57_MIBSPI
	bool
	default n
	select ARCH_HAVE_SPI_BITORDER
	---help---
		Hidden umbrella symbol selected by any RM57_MIBSPIn instance;
		pulls the shared MibSPI driver into the build.

config RM57_MIBSPI1
	bool "MibSPI1 (SPI master)"
	default n
	select RM57_MIBSPI
	select SPI
	---help---
		Multi-buffered SPI module 1 as an SPI master.  SPICLK, SIMO[0]
		and SOMI[0] are dedicated balls (F18, F19, G18).

config RM57_MIBSPI2
	bool "MibSPI2 (SPI master)"
	default n
	select RM57_MIBSPI
	select SPI
	---help---
		Multi-buffered SPI module 2 as an SPI master.  All of its
		signals are alternate functions of N2HET2 balls, so the board
		pin-mux table has to route them.  Two chip selects only.

config RM57_MIBSPI3
	bool "MibSPI3 (SPI master)"
	default n
	select RM57_MIBSPI
	select SPI
	---help---
		Multi-buffered SPI module 3 as an SPI master.  Its balls reset
		to their MibSPI3 function.

config RM57_MIBSPI4
	bool "MibSPI4 (SPI master)"
	default n
	select RM57_MIBSPI
	select SPI
	---help---
		Multi-buffered SPI module 4 as an SPI master.  All of its
		signals are alternate functions of N2HET1 balls, so the board
		pin-mux table has to route them.

config RM57_MIBSPI5
	bool "MibSPI5 (SPI master)"
	default n
	select RM57_MIBSPI
	select SPI
	---help---
		Multi-buffered SPI module 5 as an SPI master, on SIMO[0] and
		SOMI[0] only; the parallel data lines are not used.  Its balls
		reset to their MibSPI5 function.

config RM57_MIBSPI_MULTIBUF
	bool
	default n
	---help---
		Hidden symbol selected by any RM57_MIBSPIn_MULTIBUF; pulls the
		multi-buffer transfer path into the driver.

config RM57_MIBSPI1_MULTIBUF
	bool "MibSPI1 multi-buffer mode"
	default n
	depends on RM57_MIBSPI1
	select RM57_MIBSPI_MULTIBUF
	---help---
		Run MibSPI1 in multi-buffer mode instead of compatibility mode.
		Transfers go through the module's buffer RAM in passes of up to
		255 words (extended 256-buffer mode), one interrupt per pass
		instead of one register round-trip per word.  The mode is fixed
		at initialization: switching it re-initializes the buffer RAM.

config RM57_MIBSPI2_MULTIBUF
	bool "MibSPI2 multi-buffer mode"
	default n
	depends on RM57_MIBSPI2
	select RM57_MIBSPI_MULTIBUF
	---help---
		As RM57_MIBSPI1_MULTIBUF, in passes of up to 128 words.

config RM57_MIBSPI3_MULTIBUF
	bool "MibSPI3 multi-buffer mode"
	default n
	depends on RM57_MIBSPI3
	select RM57_MIBSPI_MULTIBUF
	---help---
		As RM57_MIBSPI1_MULTIBUF, in passes of up to 128 words.

config RM57_MIBSPI4_MULTIBUF
	bool "MibSPI4 multi-buffer mode"
	default n
	depends on RM57_MIBSPI4
	select RM57_MIBSPI_MULTIBUF
	---help---
		As RM57_MIBSPI1_MULTIBUF, in passes of up to 128 words.

config RM57_MIBSPI5_MULTIBUF
	bool "MibSPI5 multi-buffer mode"
	default n
	depends on RM57_MIBSPI5
	select RM57_MIBSPI_MULTIBUF
	---help---
		As RM57_MIBSPI1_MULTIBUF, in passes of up to 128 words.

config RM57_MIBSPI_DMA
	bool
	default n
	select RM57_DMA
	---help---
		Hidden symbol selected by any RM57_MIBSPIn_DMA; pulls the
		compatibility-mode DMA path into the driver.

config RM57_MIBSPI1_DMA
	bool "MibSPI1 DMA (compatibility mode)"
	default n
	depends on RM57_MIBSPI1 && !RM57_MIBSPI1_MULTIBUF
	select RM57_MIBSPI_DMA
	---help---
		Move compatibility-mode transfers of RM57_MIBSPI_DMATHRESHOLD
		words or more by DMA, on request lines 1 (TX) and 0 (RX),
		instead of polling every word.  The caller sleeps until the
		receive channel completes.

config RM57_MIBSPI2_DMA
	bool "MibSPI2 DMA (compatibility mode)"
	default n
	depends on RM57_MIBSPI2 && !RM57_MIBSPI2_MULTIBUF
	select RM57_MIBSPI_DMA
	---help---
		As RM57_MIBSPI1_DMA, on request lines 3 (TX) and 2 (RX).

config RM57_MIBSPI3_DMA
	bool "MibSPI3 DMA (compatibility mode)"
	default n
	depends on RM57_MIBSPI3 && !RM57_MIBSPI3_MULTIBUF
	select RM57_MIBSPI_DMA
	---help---
		As RM57_MIBSPI1_DMA, on request lines 15 (TX) and 14 (RX).
		Line 14 is shared with the MibADC2 event trigger DMA request;
		the two cannot be used together.

config RM57_MIBSPI_DMATHRESHOLD
	int "MibSPI DMA threshold (words)"
	default 16
	depends on RM57_MIBSPI_DMA
	---help---
		Shorter transfers are polled: setting up two channels and
		sleeping costs more than the transfer itself.

config RM57_MIBSPI_DMABUFSIZE
	int "MibSPI DMA bounce buffer size (words)"
	default 256
	range 16 8176
	depends on RM57_MIBSPI_DMA
	---help---
		DMA goes through a cache-line-aligned transmit and receive
		buffer of this many 16-bit words per module, so that the
		caller's buffers need no particular alignment.  Longer
		transfers are split into blocks of this size.

config RM57_MIBSPI_LOOPBACK
	bool "MibSPI internal loopback (self-test)"
	default n
	depends on RM57_MIBSPI
	---help---
		Set SPIGCR1.LOOPBACK on every enabled MibSPI module: transmit
		data is fed back to the receiver inside the module, SPICLK
		stays at its idle level and nothing reaches the pins.  Lets the
		driver be exercised with nothing connected - the
		RM57_DCAN_LOOPBACK equivalent for SPI.

config RM57_I2C
	bool
	default n
	select I2C
	select ARCH_HAVE_I2CRESET
	---help---
		Hidden umbrella symbol selected by any RM57_I2Cn instance;
		pulls the shared I2C master driver into the build.

config RM57_I2C1
	bool "I2C1 (I2C master)"
	default n
	select RM57_I2C
	---help---
		I2C module 1 as an interrupt-driven master.  SDA and SCL are
		alternate functions of balls B2 and C3, which reset to
		MIBSPI3NCS[2] and MIBSPI3NCS[3]; the board pin-mux table has
		to route them, and MibSPI3 loses those two chip selects.

config RM57_I2C2
	bool "I2C2 (I2C master)"
	default n
	select RM57_I2C
	---help---
		I2C module 2 as an interrupt-driven master.  SDA and SCL are
		alternate functions of balls G17 and G16, which reset to
		MIBSPI5SIMO[3] and MIBSPI5SOMI[3].

config RM57_I2C_TIMEOUT_MS
	int "I2C transfer timeout slack (ms)"
	default 20
	depends on RM57_I2C
	---help---
		Added to four times the nominal duration of every transfer
		segment before it is abandoned and the module reset.  Also
		bounds how long a transfer waits for the bus to go idle.
		Raise it for slaves that stretch the clock for long.

config RM57_I2C_LOOPBACK
	bool "I2C digital loopback (self-test)"
	default n
	depends on RM57_I2C
	---help---
		Let the board run every enabled I2C module through its
		digital loopback mode (I2CMDR.DLB) at start-up: the module
		addresses itself, so master-transmit transfers complete and
		the bytes come back through the receive register with
		nothing connected to the bus.  Only the transmit path is
		covered; master receive needs a real slave.

config RM57_ADC
	bool
	default n
	---help---
		Hidden umbrella symbol selected by any RM57_ADCn instance;
		pulls the shared MibADC driver into the build.

config RM57_ADC_HAVE_DMA
	bool
	default n
	---help---
		Hidden symbol selected by any conversion group configured to
		move its results with the DMA controller.

menuconfig RM57_ADC1
	bool "MibADC1 (32 channels)"
	default n
	select RM57_ADC
	select ADC
	select ANALOG
	---help---
		TI MibADC module 1, a 10/12-bit successive approximation
		converter with 32 analog inputs and three independent
		conversion groups.

if RM57_ADC1

choice
	prompt "ADC1 resolution"
	default RM57_ADC1_12BIT
	---help---
		Resolution of the converter core.  This is a module-wide
		setting: all three conversion groups share it.

config RM57_ADC1_12BIT
	bool "12-bit"

config RM57_ADC1_10BIT
	bool "10-bit"

endchoice # ADC1 resolution

config RM57_ADC1_CLOCK
	int "ADC1 conversion clock (Hz)"
	default 9375000
	range 2400000 30000000
	---help---
		Target ADCLK frequency.  The prescaler is computed from
		BOARD_VCLK_FREQUENCY as ADCLK = VCLK / (PS + 1) and rounded so
		the result never exceeds this value.  SPNS215 specifies
		tc(ADCLK) >= 33ns, i.e. an ADCLK ceiling of 30MHz, which is
		checked at compile time.

menuconfig RM57_ADC1_EV
	bool "ADC1 Event group"
	default n
	---help---
		Expose the ADC1 Event group as its own /dev/adcN character device.
		The group has an independent channel selection, trigger source,
		sampling window, results FIFO and interrupt (VIM channel
		RM57_REQ_ADC1GROUP0).

if RM57_ADC1_EV

config RM57_ADC1_EV_CHANMASK
	hex "ADC1 Event group channel mask"
	default 0x1
	---help---
		Bit mask of the analog inputs converted by this group; bit n
		selects AD1IN[n].  In the default sequential mode the selected
		channels are converted in ascending channel number.

config RM57_ADC1_EV_BUFS
	int "ADC1 Event group result buffers"
	default 16
	range 0 64
	---help---
		Words of the module's 64-word results RAM reserved for this
		group.  The Event group and Group1 counts must be even because
		ADBNDCR allocates the memory in pairs, and the three groups of
		one module must not ask for more than 64 words in total.  Both
		rules are checked at compile time.

config RM57_ADC1_EV_THRESHOLD
	int "ADC1 Event group interrupt threshold"
	default 8
	range 1 511
	---help---
		How many conversion results accumulate before the group raises
		its threshold interrupt.  Larger values reduce the interrupt
		rate but need a correspondingly larger result buffer count.

config RM57_ADC1_EV_ACQ
	int "ADC1 Event group acquisition time"
	default 8
	range 1 4095
	---help---
		Sampling window in ADCLK cycles minus two: SW = ACQ + 2, and the
		hardware requires SW >= 3.  The input impedance sets the real
		minimum - see the sample and hold timings in SPNS215.  When both
		modules convert a shared channel their windows must either match
		exactly or not overlap at all (TRM section 22.1).

config RM57_ADC1_EV_CONTINUOUS
	bool "ADC1 Event group continuous conversion"
	default n
	---help---
		Convert the selected channels continuously instead of once per
		trigger.  Continuous groups report results through the threshold
		interrupt; single-shot groups use the conversion end interrupt.

config RM57_ADC1_EV_FREEZE
	bool "ADC1 Event group freeze enable"
	default n
	---help---
		Allow this group's conversion sequence to be suspended while
		another group of the same module is serviced, resuming from
		where it stopped afterwards.

config RM57_ADC1_EV_OVRWRITE
	bool "ADC1 Event group overwrite on overrun"
	default n
	---help---
		Let the ADC overwrite the oldest results when this group's
		memory fills up.  Without it the group stalls until the
		application has read the memory out.

# The Event group has no hardware trigger enable bit - bit 3 of ADEVMODECR
# is reserved, where Group1 and Group2 have HW_TRIG - because it is always
# started by its trigger source.  Only the source and its edge are
# selectable.

config RM57_ADC1_EV_TRIGSRC
	int "ADC1 Event group trigger source"
	default 0
	range 0 7
	---help---
		Hardware trigger source: 0 = AD1EVT pin, 1 = N2HET1[8],
		2 = N2HET1[10], 3 = RTI compare 0, 4 = N2HET1[12],
		5 = N2HET1[14], 6 = GIOB[0], 7 = GIOB[1].  A second set of
		sources is reachable through the ALT_ADC_TRIGGER pin mux
		control; see SPNS215.

config RM57_ADC1_EV_RISING
	bool "ADC1 Event group trigger on rising edge"
	default y
	---help---
		Trigger on the low-to-high transition of the selected source
		rather than the high-to-low transition.

config RM57_ADC1_EV_DMA
	bool "ADC1 Event group DMA result transfer"
	default n
	depends on RM57_DMA
	select RM57_ADC_HAVE_DMA
	---help---
		Move conversion results out of the group's FIFO with the DMA
		controller (request line DMA_REQ_MIBADC1_EVT) instead of reading
		them in the interrupt handler, and deliver them to the upper
		half in batches.

config RM57_ADC1_EV_DMA_NSAMPLES
	int "ADC1 Event group DMA samples per transfer"
	default 16
	range 1 256
	depends on RM57_ADC1_EV_DMA
	---help---
		Results delivered per DMA callback.  The landing buffer holds
		two of these so the ADC can fill one half while the other is
		being handed to the upper half.  Two constraints are checked
		at compile time: it must not exceed
		RM57_ADC_DMA_MAXSAMPLES, which sizes the scratch arrays the
		callback puts on the interrupt stack, and it must be a
		multiple of eight so each half of the ring is a whole number
		of D-cache lines.

endif # RM57_ADC1_EV

