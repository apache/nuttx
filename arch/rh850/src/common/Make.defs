# The start-up, "head", file

HEAD_ASRC += rh850_head.S

# Common RH850 files

CMN_ASRCS += rh850_exception_common.S
CMN_ASRCS += rh850_saveusercontext.S

CMN_CSRCS += rh850_allocateheap.c
CMN_CSRCS += rh850_checkstack.c
CMN_CSRCS += rh850_createstack.c
CMN_CSRCS += rh850_doirq.c
CMN_CSRCS += rh850_exception.c
CMN_CSRCS += rh850_exit.c
CMN_CSRCS += rh850_fpucmp.c
CMN_CSRCS += rh850_getintstack.c
CMN_CSRCS += rh850_idle.c
CMN_CSRCS += rh850_initialize.c
CMN_CSRCS += rh850_initialstate.c
CMN_CSRCS += rh850_irq.c
CMN_CSRCS += rh850_nputs.c
CMN_CSRCS += rh850_registerdump.c
CMN_CSRCS += rh850_releasestack.c
CMN_CSRCS += rh850_stackframe.c
CMN_CSRCS += rh850_start.c
CMN_CSRCS += rh850_swint.c
CMN_CSRCS += rh850_switchcontext.c
CMN_CSRCS += rh850_usestack.c

ifeq ($(CONFIG_ENABLE_ALL_SIGNALS),y)
CMN_CSRCS += rh850_schedulesigaction.c
CMN_CSRCS += rh850_sigdeliver.c
endif
