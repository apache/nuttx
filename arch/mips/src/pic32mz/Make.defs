# The start-up, "head", file

HEAD_ASRC = pic32mz_head.S

# Common MIPS files

CMN_ASRCS  = mips_syscall0.S fork.S mips_cache.S
CMN_CSRCS  = mips_allocateheap.c mips_copystate.c mips_createstack.c
CMN_CSRCS += mips_doirq.c mips_exit.c mips_getintstack.c mips_initialize.c
CMN_CSRCS += mips_initialstate.c mips_irq.c mips_lowputs.c
CMN_CSRCS += mips_modifyreg8.c mips_modifyreg16.c mips_modifyreg32.c
CMN_CSRCS += mips_nputs.c mips_releasestack.c mips_registerdump.c
CMN_CSRCS += mips_stackframe.c mips_switchcontext.c mips_saveusercontext.c
CMN_CSRCS += mips_usestack.c mips_fork.c mips_swint0.c

# Configuration dependent common files

ifeq ($(CONFIG_ENABLE_ALL_SIGNALS),y)
CMN_CSRCS += mips_schedulesigaction.c mips_sigdeliver.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CMN_CSRCS += mips_idle.c
endif

# Use of common/mips_etherstub.c is deprecated.  The preferred mechanism is to
# use CONFIG_NETDEV_LATEINIT=y to suppress the call to mips_netinitialize() in
# mips_initialize().  Then this stub would not be needed.

ifneq ($(CONFIG_PIC32MZ_ETHERNET),y)
ifeq ($(CONFIG_NET),y)
CMN_CSRCS += mips_etherstub.c
endif
endif

# Required PIC32MZ files

CHIP_CSRCS  = pic32mz_lowinit.c pic32mz_exception.c pic32mz_decodeirq.c
CHIP_CSRCS += pic32mz_irq.c pic32mz_timerisr.c pic32mz_gpio.c
CHIP_CSRCS += pic32mz_lowconsole.c pic32mz_serial.c

# Configuration-dependent PIC32MZ files

ifeq ($(CONFIG_ARCH_CHIP_WFI32E01),y)
CHIP_CSRCS += pic32mz_wfi32_pwrclk.c
endif

ifeq ($(CONFIG_PIC32MZ_W1_WLAN),y)
CHIP_CSRCS += pic32mz_w1_wlan.c pic32mz_w1_wlan_crypto.c

# Microchip's WLAN library is not part of NuttX: download it from the
# MPLAB Harmony wireless_wifi repository, unless a copy is already there.

WLAN_VER = v3.13.0
WLAN_URL = https://github.com/Microchip-MPLAB-Harmony/wireless_wifi/raw/$(WLAN_VER)/driver/pic32mzw1
WLAN_SRCLIB = chip$(DELIM)pic32mzw1.a
WLAN_LIB = chip$(DELIM)libpic32mzw1_nx.a

# Link a copy of the library with some symbols renamed: the global
# symbols that clash with NuttX (net checksum(), crypto aes_key_wrap() and
# aes_key_unwrap()), and the C library output functions it calls, so that
# the driver can send its messages to the syslog.  __printf_npuxX is XC32's
# printf variant for formats that only use %n, %p, %u, %x and %X.

WLAN_RENAME = checksum aes_key_wrap aes_key_unwrap printf puts putchar

$(WLAN_SRCLIB):
	$(call DOWNLOAD,$(WLAN_URL),pic32mzw1.a,$(WLAN_SRCLIB))

$(WLAN_LIB): $(WLAN_SRCLIB)
	$(Q) $(OBJCOPY) $(foreach s,$(WLAN_RENAME),--redefine-sym $(s)=pic32mzw1_$(s)) \
	  --redefine-sym __printf_npuxX=pic32mzw1_printf_npux $< $@

context:: $(WLAN_LIB)

EXTRA_LIBS += $(ARCH_SRCDIR)$(DELIM)$(WLAN_LIB)

# The library refers to a few SFRs by name, as XC32's device support
# defines them (DS70005425 / PIC32MZ-W_DFP pwfi32e01.h).

LDFLAGS += --defsym=DEVID=0xbf800060 --defsym=IEC2=0xbf8100e0
LDFLAGS += --defsym=NVMCON=0xbf800600 --defsym=NVMKEY=0xbf800620
LDFLAGS += --defsym=NVMADDR=0xbf800630 --defsym=NVMDATA0=0xbf800640
LDFLAGS += --defsym=NVMSRCADDR=0xbf8006c0 --defsym=NVMLBWP=0xbf8006f0
endif

# Delete the downloaded library and its copy whatever the configuration

distclean::
	$(call DELFILE, chip$(DELIM)pic32mzw1.a)
	$(call DELFILE, chip$(DELIM)libpic32mzw1_nx.a)

ifeq ($(CONFIG_PIC32MZ_GPIOIRQ),y)
CHIP_CSRCS += pic32mz_gpioirq.c
endif

ifeq ($(CONFIG_PIC32MZ_SPI),y)
CHIP_CSRCS += pic32mz_spi.c
endif

ifeq ($(CONFIG_PIC32MZ_I2C),y)
CHIP_CSRCS += pic32mz_i2c.c
endif

ifeq ($(CONFIG_PIC32MZ_TIMER),y)
CHIP_CSRCS += pic32mz_timer.c
ifeq ($(CONFIG_TIMER),y)
CHIP_CSRCS += pic32mz_timer_lowerhalf.c
endif
endif

ifeq ($(CONFIG_PIC32MZ_FREERUN),y)
CHIP_CSRCS += pic32mz_freerun.c
endif

ifeq ($(CONFIG_PIC32MZ_ONESHOT),y)
CHIP_CSRCS += pic32mz_oneshot.c
ifeq ($(CONFIG_ONESHOT),y)
CHIP_CSRCS += pic32mz_oneshot_lowerhalf.c
endif
endif

ifeq ($(CONFIG_PIC32MZ_ETHERNET),y)
CHIP_CSRCS += pic32mz_ethernet.c
endif

ifeq ($(CONFIG_PIC32MZ_DMA),y)
CHIP_CSRCS += pic32mz_dma.c
endif
