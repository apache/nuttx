if ARCH_TRICORE
comment "Tricore Options"

choice
	prompt "Tricore Toolchain Selection"
	default TRICORE_TOOLCHAIN_GNU

config TRICORE_TOOLCHAIN_TASKING
	bool "AURIX Tasking C/C++ toolchain"
	select ARCH_TOOLCHAIN_TASKING

config TRICORE_TOOLCHAIN_GNU
	bool "Generic GNU toolchain"
	select ARCH_TOOLCHAIN_GCC
	---help---
		This option should work for any modern GNU toolchain (GCC 4.5 or newer)

endchoice # Tricore Toolchain Selection

config ARCH_TC1V6
	bool
	select ARCH_HAVE_DEBUG
	select ARCH_HAVE_MPU
	select ARCH_HAVE_HIPRI_INTERRUPT
	select ARCH_HAVE_IRQPRIO
	select ARCH_HAVE_IRQTRIGGER
	select ARCH_HAVE_PERF_EVENTS
	select ARCH_HAVE_POWEROFF
	select ARCH_HAVE_PERF_EVENTS_USER_ACCESS
	select ARCH_HAVE_SETJMP
	select ARCH_HAVE_RESET
	select ARCH_SETJMP_H
	default n

config ARCH_TC1V8
	bool
	select ARCH_DCACHE
	select ARCH_HAVE_DEBUG
	select ARCH_ICACHE
	select ARCH_HAVE_MPU
	select ARCH_HAVE_HIPRI_INTERRUPT
	select ARCH_HAVE_IRQPRIO
	select ARCH_HAVE_IRQTRIGGER
	select ARCH_HAVE_PERF_EVENTS
	select ARCH_HAVE_PERF_EVENTS_USER_ACCESS
	select ARCH_HAVE_POWEROFF
	select ARCH_HAVE_PPRS
	select ARCH_HAVE_SETJMP
	select ARCH_HAVE_RESET
	select ARCH_SETJMP_H
	default n

config ARCH_FAMILY
	string
	default "tc1v6"		if ARCH_TC1V6
	default "tc1v8"		if ARCH_TC1V8

choice
	prompt "AURIX family"
	default ARCH_CHIP_TC3X

config ARCH_CHIP_TC3X
	bool "Infineon AURIX TC3x"
	select ARCH_TC1V6
	select ARCH_HAVE_ADDRENV
	select ARCH_HAVE_MULTICPU
	select ARCH_HAVE_I2CRESET
	select ARCH_MINIMAL_VECTORTABLE
	select ARCH_MINIMAL_VECTORTABLE_DYNAMIC
	select ALARM_ARCH
	select ONESHOT
	select ONESHOT_COUNT
	---help---
		Infineon AURIX TC3x (six cores)

config ARCH_CHIP_TC4X
	bool "Infineon AURIX TC4x"
	select ARCH_TC1V8
	select ARCH_HAVE_ADDRENV
	select ARCH_HAVE_FPU if !TRICORE_CSRM
	select ARCH_HAVE_MULTICPU
	select ARCH_HAVE_I2CRESET
	select ARCH_MINIMAL_VECTORTABLE
	select ARCH_MINIMAL_VECTORTABLE_DYNAMIC
	select ALARM_ARCH
	select ONESHOT
	select ONESHOT_COUNT
	select HAVE_SECURITY_CORE
	---help---
		Infineon AURIX TC4x (six cores and one security core)

endchoice # AURIX family

config ARCH_CHIP
	string
	default "tc3xx"		if ARCH_CHIP_TC3X
	default "tc4xx"		if ARCH_CHIP_TC4X

config ARCH_IRQ_DISABLE_PRIORITY
	int "IRQ disable priority threshold"
	default 250
	range 1 255
	depends on ARCH_HIPRI_INTERRUPT
	---help---
		Interrupts with SRPN > this value are treated as
		high-priority and will not be masked.

config ARCH_DCACHE_ADDR
	hex "AURIX Dcache base address"
	default 0x7003C000
	---help---
		AURIX Dcache base address, dcache line clear and invalidate need
		use the address.

config ARCH_MPU_NSETS
	int "Protection sets number"
	default 8
	---help---
		The protection sets count

config ARCH_MPU_DATA_NREGIONS
	int "Data regions number"
	default 24
	---help---
		The data regions count

config ARCH_MPU_CODE_NREGIONS
	int "Code regions variables"
	default 16
	---help---
		The code regions count

config ARCH_HAVE_PPRS
	bool
	---help---
		The saving process for MPU PRS differs between TC1V6 and TC1V8.TC1V6
		saves PRS in the PSW, while TC1V8 saves PRS in the PPRS register.

config HAVE_SECURITY_CORE
	bool
	---help---
		In addition to the 6 cores, tc4xx also has one more security core.

config CPU_COREID
	int "TRICORE CPU CORE ID"
	default 0
	range 0 6

config TRICORE_TRAP_ALERT
	bool "Describe traps in the alert output"
	default !DEFAULT_SMALL
	depends on DEBUG_ALERT
	---help---
		Print the trap name and reason before the trap panics.  The
		panic message has the trap class and TIN in any case.

source "arch/tricore/src/common/aurix/Kconfig"

if ARCH_CHIP_TC3X
source "arch/tricore/src/tc3xx/Kconfig"
endif

if ARCH_CHIP_TC4X
source "arch/tricore/src/tc4xx/Kconfig"
endif

endif # ARCH_TRICORE
