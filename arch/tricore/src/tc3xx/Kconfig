choice
	prompt "Infineon AURIX TC3x chip selection"
	default TC3X_CHIP_TC397

config TC3X_CHIP_TC397
	bool "TC397 SoC"

endchoice

comment "TC3XX Configuration Options"

config CPU_CLOCK_FREQUENCY
	int "CPU clock frequency (Hz)"
	default 300000000
