ifeq ($(CONFIG_DEBUG_CUSTOMOPT),y)
  ARCHOPTIMIZATION += $(CONFIG_DEBUG_OPTLEVEL)
else ifeq ($(CONFIG_DEBUG_FULLOPT),y)
  ARCHOPTIMIZATION += -O2
endif

ifeq ($(CONFIG_DEBUG_SYMBOLS),y)
  ARCHOPTIMIZATION += $(CONFIG_DEBUG_SYMBOLS_LEVEL)
endif

# cctc takes -I<dir>; the generic "-I <dir>" form would make the -I%
# filters of the .asm rules below drop the directories.

INCDIR_PREFIX := -I

TASKING_LSLDIR := $(dir $(shell which ctc))..$(DELIM)include.lsl

CC      = cctc
CXX     = cctc
CPP     = ctc -Ep -I$(TASKING_LSLDIR)
LD      = cctc
STRIP   = elfstrip
AR      = artc -r -c
UNAR    = artc -x
NM      = nm
OBJCOPY = objcopy
OBJDUMP = hldumptc

# Config.mk probes the prefix before CC is set, cctc has no -isystem

INCSYSDIR_PREFIX = -I

ARCHOPTIMIZATION += --language=+gcc,+volatile
ARCHOPTIMIZATION += --integer-enumeration --signed-bitfields
ARCHOPTIMIZATION += --default-near-size=0
ARCHOPTIMIZATION += --fp-model=1

# ctc W500: expression without effect
# ctc W507: variable is possibly uninitialized
# ctc W508: empty source file
# ctc W525: discarded 'const' qualifier at assignment
# ctc W526: enumeration constant shall be representable as 'int'
# ctc W527: constant of type "double" saturated
# ctc W529: overflow in constant expression
# ctc W544: unreachable code
# ctc W549: condition is always true
# ctc W553: no 'break' or comment before case label
# ctc W557: possible infinite loop
# ctc W558: struct/union/enum definition in parameter declaration
# ctc W560: possible truncation at implicit conversion
# ctc W562: unary minus applied to unsigned value
# ctc W587: underflow on constant of type "double"
# ctc W588: dead assignment eliminated
# ctc W589: pointer assumed to be nonzero - test removed

TASKING_WARNINGS = 500,507,508,525,526,527,529,544,549,553,557,558,560,562,587,588,589

ARCHOPTIMIZATION += --pass-c=--no-warnings=$(TASKING_WARNINGS)

# NuttX brings its own startup code and C library, only the compiler
# helpers of the toolset are linked.  Duplicate code and constants are
# kept apart so that distinct objects keep distinct addresses.

LDFLAGS += --no-default-libraries -lfp_fpu -lrt
LDFLAGS += -Wl--user-provided-initialization-code
LDFLAGS += -Wl-OcLTXY

# Every function and object keeps its own section, fill the alignment
# holes between them so the hex file is a few contiguous blocks.

OBJCOPYARGS += --gap-fill=0

ifeq ($(CONFIG_DEBUG_LINK_MAP),y)
  LDFLAGS += -Wl--map-file=$(call CONVERT_PATH,$(TOPDIR)$(DELIM)nuttx.map)
endif

# The .asm files are TASKING copies of the GNU .S files, astc has no C
# preprocessor so they go through ctc first for the headers and options.

ASMEXT = .asm

TASKING_AFLAGS = -Wa--no-warnings=201

# rfh and the VCON0 write of the TC1.8 path need the hypervisor mode

ifeq ($(CONFIG_TRICORE_TC18),y)
  TASKING_AFLAGS += -Wa--user-mode=hypervisor
endif

define ASSEMBLE
	$(ECHO_BEGIN)"AS: $1 "
	$(Q) $(CPP) $(filter -D% -U% -I%,$(AFLAGS) $($(strip $1)_AFLAGS)) $1 -o $(basename $2).src
	$(Q) $(CC) -c $(ARCHCPUFLAGS) $(TASKING_AFLAGS) $(basename $2).src -o $2
	$(ECHO_END)
endef

# Cancel the generic rule, it would pick the .S file

%.dds: %.S

%.dds: %.asm
	$(Q) $(CPP) -Em --make-target=$(OBJPATH)$(DELIM)$*$(OBJEXT) $(filter -D% -U% -I%,$(CFLAGS)) $< -o $@
