ifeq ($(CONFIG_TRICORE_TOOLCHAIN_LLVM),y)
ARCHCPUFLAGS += -march=tc162 -mcpu=tc3xx
else ifeq ($(CONFIG_TRICORE_TOOLCHAIN_TASKING),y)
ifeq ($(CONFIG_TC3X_CHIP_TC375),y)
ARCHCPUFLAGS += --cpu=tc37x
else
ARCHCPUFLAGS += --cpu=tc39x
endif

# The VX-toolset deviates from the EABI by default, half word aligned
# int among others, which SmartCode and GCC do not.  Keep to the EABI.

ARCHCPUFLAGS += --eabi=BCDFHILNSVW
else
ARCHCPUFLAGS += -mtc162
endif

include $(TOPDIR)/arch/tricore/src/common/Toolchain.defs
