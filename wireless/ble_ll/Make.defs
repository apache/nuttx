ifeq ($(CONFIG_WIRELESS_BLE_LL),y)

CSRCS += ble_ll.c ble_ll_driver.c ble_ll_hci.c ble_ll_hci_ev.c
CSRCS += ble_ll_hci_supp_cmd.c ble_ll_hw.c ble_ll_iob.c ble_ll_pdu.c
CSRCS += ble_ll_rand.c ble_ll_resolv.c ble_ll_rfmgmt.c ble_ll_sched.c
CSRCS += ble_ll_tmr.c ble_ll_utils.c ble_ll_whitelist.c

ifeq ($(CONFIG_BLE_LL_ROLE_BROADCASTER),y)
CSRCS += ble_ll_adv.c
endif

ifeq ($(CONFIG_BLE_LL_ROLE_OBSERVER),y)
CSRCS += ble_ll_scan.c

ifeq ($(CONFIG_BLE_LL_CFG_FEAT_LL_EXT_ADV),y)
CSRCS += ble_ll_scan_aux.c
endif

ifeq ($(CONFIG_BLE_LL_CFG_FEAT_LL_PERIODIC_ADV),y)
CSRCS += ble_ll_sync.c
endif
endif

ifneq ($(CONFIG_BLE_LL_ROLE_CENTRAL)$(CONFIG_BLE_LL_ROLE_PERIPHERAL),)
CSRCS += ble_ll_conn.c ble_ll_conn_hci.c ble_ll_ctrl.c
endif

DEPPATH += --dep-path ble_ll
VPATH += :ble_ll

endif # CONFIG_WIRELESS_BLE_LL
