menuconfig MM_NET_BUF
	bool "Network Buffer (net_buf) support"
	default n
	---help---
		Enable the net_buf buffer management framework ported from Zephyr.
		Provides fixed-size buffer pools with reference counting, fragment
		chaining, and net_buf_simple lightweight byte buffer operations.

if MM_NET_BUF

config NET_BUF_ALIGNMENT
	int "Buffer alignment"
	default 0
	---help---
		Alignment for net_buf buffers. 0 means align to pointer size.

endif # MM_NET_BUF