ifeq ($(CONFIG_FS_XIPFS),y)

# Add the xipfs C files to the build

CSRCS += xipfs_alloc.c
CSRCS += xipfs_defrag.c
CSRCS += xipfs_flash.c
CSRCS += xipfs_meta.c
CSRCS += xipfs_mmap.c
CSRCS += xipfs_vfs.c

# Add the xipfs directory to the build

DEPPATH += --dep-path xipfs
VPATH += :xipfs
endif
