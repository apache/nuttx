From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v-yanxingyu <v-yanxingyu@xiaomi.com>
Date: Mon, 11 May 2026 11:42:05 +0800
Subject: [PATCH] littlefs: add lfs_file_path for absolute path retrieval

Add lfs_file_path() to retrieve the absolute path of an open file
handle. Required by NuttX VFS layer for FIOC_FILEPATH ioctl and
fstat/fchstat (via libc path-based lfs_getattr/lfs_setattr APIs).

The implementation adds:
- Static helper lfs_dir_path_() placed in Directory operations
  section, grouped with other lfs_dir_*_ helpers.
- Public API lfs_file_path() that follows lfs_file_size() template
  (LFS_LOCK/TRACE/ASSERT pattern, returns lfs_ssize_t).

Signed-off-by: v-yanxingyu <v-yanxingyu@xiaomi.com>
---
 lfs.c | 58 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 lfs.h |  7 +++++++
 2 files changed, 65 insertions(+)

--- ./littlefs/littlefs/lfs.c
+++ ./littlefs/littlefs/lfs.c
@@ -588,6 +588,8 @@ static int lfs1_traverse(lfs_t *lfs,
 #endif
 
 static int lfs_dir_rewind_(lfs_t *lfs, lfs_dir_t *dir);
+static lfs_ssize_t lfs_dir_path_(lfs_t *lfs,
+        lfs_mdir_t *dir, uint16_t id, char *path, lfs_size_t size);
 
 static lfs_ssize_t lfs_file_flushedread(lfs_t *lfs, lfs_file_t *file,
         void *buffer, lfs_size_t size);
@@ -2868,6 +2870,46 @@ static int lfs_dir_rewind_(lfs_t *lfs, lfs_dir_t *dir) {
     return 0;
 }
 
+static lfs_ssize_t lfs_dir_path_(lfs_t *lfs,
+        lfs_mdir_t *dir, uint16_t id, char *path, lfs_size_t size) {
+    struct lfs_info info;
+    char *next = path;
+    lfs_mdir_t parent;
+    lfs_ssize_t len;
+    lfs_stag_t tag;
+    int err;
+    if (lfs_pair_cmp(lfs->root, dir->pair) != 0) {
+        tag = lfs_fs_parent(lfs, dir->pair, &parent);
+        if (tag < 0) {
+            return tag;
+        }
+        len = lfs_dir_path_(lfs, &parent, lfs_tag_id(tag), next, size);
+        if (len < 0) {
+            return len;
+        }
+        next += len;
+        size -= len;
+    }
+    err = lfs_dir_getinfo(lfs, dir, id, &info);
+    if (err < 0) {
+        return err;
+    }
+    len = strlen(info.name);
+    if (len >= (lfs_ssize_t)size) {
+        return LFS_ERR_INVAL;
+    }
+    memcpy(next, info.name, len + 1);
+    next += len;
+    if (info.type == LFS_TYPE_DIR) {
+        *next++ = '/';
+        if (++len >= (lfs_ssize_t)size) {
+            return LFS_ERR_INVAL;
+        }
+        *next = '\0';
+    }
+    return next - path;
+}
+
 
 /// File index list operations ///
 static int lfs_ctz_index(lfs_t *lfs, lfs_off_t *off) {
@@ -6322,6 +6364,22 @@ lfs_soff_t lfs_file_size(lfs_t *lfs, lfs_file_t *file) {
     return res;
 }
 
+lfs_ssize_t lfs_file_path(lfs_t *lfs, lfs_file_t *file, char *path, lfs_size_t size) {
+    int err = LFS_LOCK(lfs->cfg);
+    if (err) {
+        return err;
+    }
+    LFS_TRACE("lfs_file_path(%p, %p, %p, %"PRIu32")",
+            (void*)lfs, (void*)file, (void*)path, size);
+    LFS_ASSERT(lfs_mlist_isopen(lfs->mlist, (struct lfs_mlist*)file));
+
+    lfs_ssize_t res = lfs_dir_path_(lfs, &file->m, file->id, path, size);
+
+    LFS_TRACE("lfs_file_path -> %"PRId32, res);
+    LFS_UNLOCK(lfs->cfg);
+    return res;
+}
+
 #ifndef LFS_READONLY
 int lfs_mkdir(lfs_t *lfs, const char *path) {
     int err = LFS_LOCK(lfs->cfg);
--- ./littlefs/littlefs/lfs.h
+++ ./littlefs/littlefs/lfs.h
@@ -656,6 +656,13 @@ int lfs_file_rewind(lfs_t *lfs, lfs_file_t *file);
 // Returns the size of the file, or a negative error code on failure.
 lfs_soff_t lfs_file_size(lfs_t *lfs, lfs_file_t *file);
 
+// Get the absolute path of the open file.
+//
+// Returns the length of the path written to the path buffer (not including
+// the null terminator), or a negative error code on failure.
+lfs_ssize_t lfs_file_path(lfs_t *lfs, lfs_file_t *file,
+        char *path, lfs_size_t size);
+
 
 /// Directory operations ///
 
