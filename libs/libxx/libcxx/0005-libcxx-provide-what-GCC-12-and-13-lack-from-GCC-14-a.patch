diff --git a/include/__tuple/tuple_element.h b/include/__tuple/tuple_element.h
index f67c867464..9f461733be 100644
--- a/include/__tuple/tuple_element.h
+++ b/include/__tuple/tuple_element.h
@@ -40,10 +40,22 @@ struct tuple_element<_Ip, const volatile _Tp> {
 
 #ifndef _LIBCPP_CXX03_LANG
 
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+template <size_t _Ip, class... _Types> struct __type_pack_element_fallback;
+template <class _Head, class... _Tail>
+struct __type_pack_element_fallback<0, _Head, _Tail...> { using type = _Head; };
+template <size_t _Ip, class _Head, class... _Tail>
+struct __type_pack_element_fallback<_Ip, _Head, _Tail...> : __type_pack_element_fallback<_Ip - 1, _Tail...> {};
+#endif
+
 template <size_t _Ip, class... _Types>
 struct tuple_element<_Ip, __tuple_types<_Types...> > {
   static_assert(_Ip < sizeof...(_Types), "tuple_element index out of range");
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+  using type _LIBCPP_NODEBUG = typename __type_pack_element_fallback<_Ip, _Types...>::type;
+#else
   using type _LIBCPP_NODEBUG = __type_pack_element<_Ip, _Types...>;
+#endif
 };
 
