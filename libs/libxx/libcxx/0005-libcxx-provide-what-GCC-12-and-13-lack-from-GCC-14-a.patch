diff --git a/include/__new/allocate.h b/include/__new/allocate.h
index 9bfe19aedb..7541dbb504 100644
--- a/include/__new/allocate.h
+++ b/include/__new/allocate.h
@@ -37,10 +37,18 @@ __libcpp_allocate(__element_count __n, [[__maybe_unused__]] size_t __align = _LI
   size_t __size = static_cast<size_t>(__n) * sizeof(_Tp);
 #if _LIBCPP_HAS_ALIGNED_ALLOCATION
   if (__is_overaligned_for_new(__align))
+#if defined(_LIBCPP_COMPILER_GCC)
+    return static_cast<_Tp*>(::operator new(__size, static_cast<align_val_t>(__align)));
+#else
     return static_cast<_Tp*>(__builtin_operator_new(__size, static_cast<align_val_t>(__align)));
 #endif
+#endif
 
+#if defined(_LIBCPP_COMPILER_GCC)
+  return static_cast<_Tp*>(::operator new(__size));
+#else
   return static_cast<_Tp*>(__builtin_operator_new(__size));
+#endif
 }
 
 #if _LIBCPP_HAS_SIZED_DEALLOCATION
@@ -57,10 +65,19 @@ __libcpp_deallocate(__type_identity_t<_Tp>* __ptr,
   [[__maybe_unused__]] size_t __size = static_cast<size_t>(__n) * sizeof(_Tp);
 #if _LIBCPP_HAS_ALIGNED_ALLOCATION
   if (__is_overaligned_for_new(__align))
+#if defined(_LIBCPP_COMPILER_GCC)
+    return ::operator delete(
+        __ptr _LIBCPP_ONLY_IF_SIZED_DEALLOCATION(, __size), static_cast<align_val_t>(__align));
+#else
     return __builtin_operator_delete(
         __ptr _LIBCPP_ONLY_IF_SIZED_DEALLOCATION(, __size), static_cast<align_val_t>(__align));
 #endif
+#endif
+#if defined(_LIBCPP_COMPILER_GCC)
+  return ::operator delete(__ptr _LIBCPP_ONLY_IF_SIZED_DEALLOCATION(, __size));
+#else
   return __builtin_operator_delete(__ptr _LIBCPP_ONLY_IF_SIZED_DEALLOCATION(, __size));
+#endif
 }
 
 #undef _LIBCPP_ONLY_IF_SIZED_DEALLOCATION
diff --git a/include/__tuple/make_tuple_types.h b/include/__tuple/make_tuple_types.h
index a5c9bcf23a..758a58cfc7 100644
--- a/include/__tuple/make_tuple_types.h
+++ b/include/__tuple/make_tuple_types.h
@@ -41,7 +41,12 @@ template <template <class...> class _Tuple, class... _Types, size_t... _Idx>
 struct __make_tuple_types_flat<_Tuple<_Types...>, __tuple_indices<_Idx...>> {
   // Specialization for pair, tuple, and __tuple_types
   template <class _Tp>
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+  using __apply_quals _LIBCPP_NODEBUG =
+      __tuple_types<__copy_cvref_t<_Tp, typename __type_pack_element_fallback<_Idx, _Types...>::type>...>;
+#else
   using __apply_quals _LIBCPP_NODEBUG = __tuple_types<__copy_cvref_t<_Tp, __type_pack_element<_Idx, _Types...>>...>;
+#endif
 };
 
