diff --git a/include/__bit/countl.h b/include/__bit/countl.h
index 0759140208..d5ccc30260 100644
--- a/include/__bit/countl.h
+++ b/include/__bit/countl.h
@@ -25,7 +25,18 @@ _LIBCPP_BEGIN_NAMESPACE_STD
 template <class _Tp>
 _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX14 int __countl_zero(_Tp __t) _NOEXCEPT {
   static_assert(__is_unsigned_integer_v<_Tp>, "__countl_zero requires an unsigned integer type");
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+  if (__t == 0)
+    return numeric_limits<_Tp>::digits;
+  if constexpr (sizeof(_Tp) <= sizeof(unsigned int))
+    return __builtin_clz(static_cast<unsigned int>(__t)) - (numeric_limits<unsigned int>::digits - numeric_limits<_Tp>::digits);
+  else if constexpr (sizeof(_Tp) <= sizeof(unsigned long))
+    return __builtin_clzl(static_cast<unsigned long>(__t)) - (numeric_limits<unsigned long>::digits - numeric_limits<_Tp>::digits);
+  else
+    return __builtin_clzll(static_cast<unsigned long long>(__t)) - (numeric_limits<unsigned long long>::digits - numeric_limits<_Tp>::digits);
+#else
   return __builtin_clzg(__t, numeric_limits<_Tp>::digits);
+#endif
 }
 
 #if _LIBCPP_STD_VER >= 20
diff --git a/include/__bit/countr.h b/include/__bit/countr.h
index f6c98695d3..b5f1852a7c 100644
--- a/include/__bit/countr.h
+++ b/include/__bit/countr.h
@@ -25,7 +25,18 @@ _LIBCPP_BEGIN_NAMESPACE_STD
 template <class _Tp>
 [[__nodiscard__]] _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR int __countr_zero(_Tp __t) _NOEXCEPT {
   static_assert(__is_unsigned_integer_v<_Tp>, "__countr_zero only works with unsigned types");
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+  if (__t == 0)
+    return numeric_limits<_Tp>::digits;
+  if constexpr (sizeof(_Tp) <= sizeof(unsigned int))
+    return __builtin_ctz(static_cast<unsigned int>(__t));
+  else if constexpr (sizeof(_Tp) <= sizeof(unsigned long))
+    return __builtin_ctzl(static_cast<unsigned long>(__t));
+  else
+    return __builtin_ctzll(static_cast<unsigned long long>(__t));
+#else
   return __builtin_ctzg(__t, numeric_limits<_Tp>::digits);
+#endif
 }
 
