diff --git a/include/__bit/popcount.h b/include/__bit/popcount.h
index 8d9ba09938..609dfd8365 100644
--- a/include/__bit/popcount.h
+++ b/include/__bit/popcount.h
@@ -24,7 +24,16 @@ _LIBCPP_BEGIN_NAMESPACE_STD
 template <class _Tp>
 [[__nodiscard__]] _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR int __popcount(_Tp __t) _NOEXCEPT {
   static_assert(__is_unsigned_integer_v<_Tp>, "__popcount only works with unsigned types");
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER < 1400
+  if constexpr (sizeof(_Tp) <= sizeof(unsigned int))
+    return __builtin_popcount(static_cast<unsigned int>(__t));
+  else if constexpr (sizeof(_Tp) <= sizeof(unsigned long))
+    return __builtin_popcountl(static_cast<unsigned long>(__t));
+  else
+    return __builtin_popcountll(static_cast<unsigned long long>(__t));
+#else
   return __builtin_popcountg(__t);
+#endif
 }
 
