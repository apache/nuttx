config BT_EAD
	bool "Encrypted Advertising Data"
	select BT_HOST_CCM
	help
	  Enable the Encrypted Advertising Data library

config LIBSBC
	bool "SBC codec support"
	default n
	help
	  Enable the SBC codec helper used by Bluetooth Classic A2DP.
