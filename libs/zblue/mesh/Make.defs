ifeq ($(CONFIG_BT_MESH),y)

BT_CSRCS += $(TOPDIR)/libs/zblue/mesh/main.c $(TOPDIR)/libs/zblue/mesh/cfg.c
BT_CSRCS += $(TOPDIR)/libs/zblue/mesh/adv.c $(TOPDIR)/libs/zblue/mesh/beacon.c
