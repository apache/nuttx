VPATH += $(TOPDIR)/libs/zblue/mesh
DEPPATH += --dep-path $(TOPDIR)/libs/zblue/mesh
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/libs/zblue/mesh

