ifeq ($(CONFIG_BT),y)

# Kernel compat layer
BT_CSRCS += queue.c timeout.c mem_slab.c

# Support modules
BT_CSRCS += fs.c

# Iterable section definitions
BT_CSRCS += defines.c

# HCI driver
BT_CSRCS += hci_driver.c

VPATH += $(TOPDIR)/libs/zblue/compat/src/kernel
VPATH += $(TOPDIR)/libs/zblue/compat/src/sections
VPATH += $(TOPDIR)/libs/zblue/compat/src/subsys/fs
VPATH += $(TOPDIR)/libs/zblue/compat/src/drivers/bluetooth/hci

DEPPATH += --dep-path $(TOPDIR)/libs/zblue/compat/src/kernel
DEPPATH += --dep-path $(TOPDIR)/libs/zblue/compat/src/sections
DEPPATH += --dep-path $(TOPDIR)/libs/zblue/compat/src/subsys/fs
DEPPATH += --dep-path $(TOPDIR)/libs/zblue/compat/src/drivers/bluetooth/hci

endif
