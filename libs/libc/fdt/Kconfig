config LIBC_FDT
	bool "Flattened Device Tree Library"
	default n
	---help---
		Enable or disable Flattened Device Tree Library features.

if LIBC_FDT

config LIBC_FDT_DTC_VERSION
	string "LIBC FDT DTC Version"
	default "1.7.0"
	---help---
		Version of DTC source code to download from github.

endif # LIBC_FDT
